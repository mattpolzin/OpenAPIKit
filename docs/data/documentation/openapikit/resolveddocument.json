{"kind":"symbol","variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/openapikit\/resolveddocument"]}],"sections":[],"hierarchy":{"paths":[["doc:\/\/OpenAPIKit\/documentation\/OpenAPIKit"]]},"primaryContentSections":[{"declarations":[{"languages":["swift"],"platforms":["Linux"],"tokens":[{"kind":"attribute","text":"@dynamicMemberLookup"},{"kind":"text","text":" "},{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"ResolvedDocument"}]}],"kind":"declarations"},{"content":[{"text":"Overview","anchor":"overview","type":"heading","level":2},{"type":"paragraph","inlineContent":[{"text":"OpenAPI documents have two distinct forms of","type":"text"},{"text":" ","type":"text"},{"text":"distributing information such that not all relevant","type":"text"},{"text":" ","type":"text"},{"text":"bits of information are available in one structural","type":"text"},{"text":" ","type":"text"},{"text":"part of an OpenAPI Document.","type":"text"}]},{"items":[{"content":[{"inlineContent":[{"text":"Documents can contain references. This is great","type":"text"},{"text":" ","type":"text"},{"text":"because authors can make one part of an","type":"text"},{"text":" ","type":"text"},{"text":"OpenAPI document more concise by referencing","type":"text"},{"text":" ","type":"text"},{"text":"a component instead of writing it inline and it also","type":"text"},{"text":" ","type":"text"},{"text":"allows shared definitions to be re-used throughout","type":"text"},{"text":" ","type":"text"},{"text":"the document.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Documents can define and override certain things at","type":"text"},{"text":" ","type":"text"},{"text":"different levels of their structure. For example, a","type":"text"},{"text":" ","type":"text"},{"text":"document may define a shared set of Security","type":"text"},{"text":" ","type":"text"},{"text":"Requirements at the root and then override those","type":"text"},{"text":" ","type":"text"},{"text":"Security Requirements for particular Operations.","type":"text"}],"type":"paragraph"}]}],"type":"orderedList"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Both of these features of OpenAPI documents make it"},{"type":"text","text":" "},{"type":"text","text":"impossible to answer certain questions about a particular"},{"type":"text","text":" "},{"type":"text","text":"route or endpoint without looking to multiple disparate parts"},{"type":"text","text":" "},{"type":"text","text":"of the document and then applying certain rules to determine"},{"type":"text","text":" "},{"type":"text","text":"the relevant semantic definition of the route or endpoint being"},{"type":"text","text":" "},{"type":"text","text":"studied."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"OpenAPIKit defines canonical forms (i.e. the only true definitions)"},{"type":"text","text":" "},{"type":"text","text":"of endpoints, routes, and the whole document. These types (named"},{"type":"text","text":" "},{"type":"codeVoice","code":"ResolvedEndpoint"},{"type":"text","text":", "},{"type":"codeVoice","code":"ResolvedRoute"},{"type":"text","text":", and "},{"type":"codeVoice","code":"ResolvedDocument"},{"type":"text","text":")"},{"type":"text","text":" "},{"type":"text","text":"each allow you to get complete information about the respective components"},{"type":"text","text":" "},{"type":"text","text":"without looking to other parts of the document."}]},{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"Example","type":"text"}],"type":"strong"}]},{"type":"paragraph","inlineContent":[{"text":"You want to know what all of the parameters for a particular ","type":"text"},{"type":"codeVoice","code":"PATCH"},{"text":" endpoint are.","type":"text"},{"text":" ","type":"text"},{"text":"Without the ","type":"text"},{"type":"codeVoice","code":"ResolvedEndpoint"},{"text":" type, you would need to look at the","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"OpenAPI.Operation"},{"text":" representing the endpoint, the ","type":"text"},{"type":"codeVoice","code":"OpenAPI.PathItem"},{"text":" ","type":"text"},{"text":"representing the route containing the endpoint, and you would need to potentially","type":"text"},{"text":" ","type":"text"},{"text":"resolve references to the ","type":"text"},{"type":"codeVoice","code":"OpenAPI.Components"},{"text":".","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"With "},{"code":"ResolvedDocument","type":"codeVoice"},{"type":"text","text":", the same task is much simpler:"}]},{"code":["let document: OpenAPI.Document = ...","","let resolvedDocument = try document","    .locallyDereferenced()","    .resolved()","","let endpoint = resolvedDocument","    .routesByPath[\"\/example\/path\"]!.patch!","","\/\/ This will be all parameters defined anywhere that","\/\/ apply to this endpoint:","let parameters = endpoint.parameters"],"type":"codeListing","syntax":null}],"kind":"content"}],"identifier":{"url":"doc:\/\/OpenAPIKit\/documentation\/OpenAPIKit\/ResolvedDocument","interfaceLanguage":"swift"},"metadata":{"title":"ResolvedDocument","navigatorTitle":[{"text":"ResolvedDocument","kind":"identifier"}],"roleHeading":"Structure","modules":[{"name":"OpenAPIKit"}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"ResolvedDocument","kind":"identifier"}],"externalID":"s:10OpenAPIKit16ResolvedDocumentV","role":"symbol","symbolKind":"struct"},"abstract":[{"text":"A resolved document is a fully dereferenced","type":"text"},{"text":" ","type":"text"},{"text":"OpenAPI document that has been further distilled","type":"text"},{"text":" ","type":"text"},{"text":"to canonical representations of each component. You","type":"text"},{"text":" ","type":"text"},{"text":"create a ","type":"text"},{"code":"ResolvedDocument","type":"codeVoice"},{"text":" by calling the ","type":"text"},{"code":"resolved()","type":"codeVoice"},{"text":" ","type":"text"},{"text":"method on a ","type":"text"},{"code":"DereferencedDocument","type":"codeVoice"},{"text":".","type":"text"}],"relationshipsSections":[{"title":"Conforms To","kind":"relationships","identifiers":["doc:\/\/OpenAPIKit\/SQ"],"type":"conformsTo"}],"topicSections":[{"generated":true,"title":"Instance Properties","identifiers":["doc:\/\/OpenAPIKit\/documentation\/OpenAPIKit\/ResolvedDocument\/endpoints","doc:\/\/OpenAPIKit\/documentation\/OpenAPIKit\/ResolvedDocument\/paths","doc:\/\/OpenAPIKit\/documentation\/OpenAPIKit\/ResolvedDocument\/routes","doc:\/\/OpenAPIKit\/documentation\/OpenAPIKit\/ResolvedDocument\/routesByPath","doc:\/\/OpenAPIKit\/documentation\/OpenAPIKit\/ResolvedDocument\/security","doc:\/\/OpenAPIKit\/documentation\/OpenAPIKit\/ResolvedDocument\/underlyingDocument"],"anchor":"Instance-Properties"},{"generated":true,"title":"Subscripts","identifiers":["doc:\/\/OpenAPIKit\/documentation\/OpenAPIKit\/ResolvedDocument\/subscript(dynamicMember:)"],"anchor":"Subscripts"},{"generated":true,"title":"Default Implementations","identifiers":["doc:\/\/OpenAPIKit\/documentation\/OpenAPIKit\/ResolvedDocument\/Equatable-Implementations"],"anchor":"Default-Implementations"}],"schemaVersion":{"major":0,"patch":0,"minor":3},"references":{"doc://OpenAPIKit/SQ":{"type":"unresolvable","identifier":"doc:\/\/OpenAPIKit\/SQ","title":"Swift.Equatable"},"doc://OpenAPIKit/documentation/OpenAPIKit/ResolvedDocument/Equatable-Implementations":{"url":"\/documentation\/openapikit\/resolveddocument\/equatable-implementations","type":"topic","kind":"article","title":"Equatable Implementations","role":"collectionGroup","abstract":[],"identifier":"doc:\/\/OpenAPIKit\/documentation\/OpenAPIKit\/ResolvedDocument\/Equatable-Implementations"},"doc://OpenAPIKit/documentation/OpenAPIKit/ResolvedDocument/subscript(dynamicMember:)":{"kind":"symbol","url":"\/documentation\/openapikit\/resolveddocument\/subscript(dynamicmember:)","iden