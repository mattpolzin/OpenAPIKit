{"relationshipsSections":[{"kind":"relationships","type":"conformsTo","identifiers":["doc:\/\/OpenAPIKit\/SQ"],"title":"Conforms To"}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/OpenAPIKit\/documentation\/OpenAPIKit\/ResolvedDocument"},"sections":[],"abstract":[{"text":"A resolved document is a fully dereferenced","type":"text"},{"text":" ","type":"text"},{"text":"OpenAPI document that has been further distilled","type":"text"},{"text":" ","type":"text"},{"text":"to canonical representations of each component. You","type":"text"},{"text":" ","type":"text"},{"text":"create a ","type":"text"},{"code":"ResolvedDocument","type":"codeVoice"},{"text":" by calling the ","type":"text"},{"code":"resolved()","type":"codeVoice"},{"text":" ","type":"text"},{"text":"method on a ","type":"text"},{"type":"codeVoice","code":"DereferencedDocument"},{"text":".","type":"text"}],"schemaVersion":{"major":0,"minor":3,"patch":0},"topicSections":[{"generated":true,"identifiers":["doc:\/\/OpenAPIKit\/documentation\/OpenAPIKit\/ResolvedDocument\/endpoints","doc:\/\/OpenAPIKit\/documentation\/OpenAPIKit\/ResolvedDocument\/paths","doc:\/\/OpenAPIKit\/documentation\/OpenAPIKit\/ResolvedDocument\/routes","doc:\/\/OpenAPIKit\/documentation\/OpenAPIKit\/ResolvedDocument\/routesByPath","doc:\/\/OpenAPIKit\/documentation\/OpenAPIKit\/ResolvedDocument\/security","doc:\/\/OpenAPIKit\/documentation\/OpenAPIKit\/ResolvedDocument\/underlyingDocument"],"title":"Instance Properties","anchor":"Instance-Properties"},{"generated":true,"identifiers":["doc:\/\/OpenAPIKit\/documentation\/OpenAPIKit\/ResolvedDocument\/subscript(dynamicMember:)"],"title":"Subscripts","anchor":"Subscripts"},{"generated":true,"identifiers":["doc:\/\/OpenAPIKit\/documentation\/OpenAPIKit\/ResolvedDocument\/Equatable-Implementations"],"title":"Default Implementations","anchor":"Default-Implementations"}],"kind":"symbol","metadata":{"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"ResolvedDocument","kind":"identifier"}],"roleHeading":"Structure","symbolKind":"struct","title":"ResolvedDocument","navigatorTitle":[{"text":"ResolvedDocument","kind":"identifier"}],"modules":[{"name":"OpenAPIKit"}],"role":"symbol","externalID":"s:10OpenAPIKit16ResolvedDocumentV"},"hierarchy":{"paths":[["doc:\/\/OpenAPIKit\/documentation\/OpenAPIKit"]]},"primaryContentSections":[{"declarations":[{"languages":["swift"],"tokens":[{"kind":"attribute","text":"@dynamicMemberLookup"},{"kind":"text","text":" "},{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"ResolvedDocument"}],"platforms":["Linux"]}],"kind":"declarations"},{"kind":"content","content":[{"text":"Overview","level":2,"type":"heading","anchor":"overview"},{"inlineContent":[{"type":"text","text":"OpenAPI documents have two distinct forms of"},{"type":"text","text":" "},{"type":"text","text":"distributing information such that not all relevant"},{"type":"text","text":" "},{"type":"text","text":"bits of information are available in one structural"},{"type":"text","text":" "},{"type":"text","text":"part of an OpenAPI Document."}],"type":"paragraph"},{"type":"orderedList","items":[{"content":[{"inlineContent":[{"type":"text","text":"Documents can contain references. This is great"},{"type":"text","text":" "},{"type":"text","text":"because authors can make one part of an"},{"type":"text","text":" "},{"type":"text","text":"OpenAPI document more concise by referencing"},{"type":"text","text":" "},{"type":"text","text":"a component instead of writing it inline and it also"},{"type":"text","text":" "},{"type":"text","text":"allows shared definitions to be re-used throughout"},{"type":"text","text":" "},{"type":"text","text":"the document."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Documents can define and override certain things at","type":"text"},{"text":" ","type":"text"},{"text":"different levels of their structure. For example, a","type":"text"},{"text":" ","type":"text"},{"text":"document may define a shared set of Security","type":"text"},{"text":" ","type":"text"},{"text":"Requirements at the root and then override those","type":"text"},{"text":" ","type":"text"},{"text":"Security Requirements for particular Operations.","type":"text"}]}]}]},{"inlineContent":[{"type":"text","text":"Both of these features of OpenAPI documents make it"},{"type":"text","text":" "},{"type":"text","text":"impossible to answer certain questions about a particular"},{"type":"text","text":" "},{"type":"text","text":"route or endpoint without looking to multiple disparate parts"},{"type":"text","text":" "},{"type":"text","text":"of the document and then applying certain rules to determine"},{"type":"text","text":" "},{"type":"text","text":"the relevant semantic definition of the route or endpoint being"},{"type":"text","text":" "},{"type":"text","text":"studied."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"OpenAPIKit defines canonical forms (i.e. the only true definitions)"},{"type":"text","text":" "},{"type":"text","text":"of endpoints, routes, and the whole document. These types (named"},{"type":"text","text":" "},{"type":"codeVoice","code":"ResolvedEndpoint"},{"type":"text","text":", "},{"type":"codeVoice","code":"ResolvedRoute"},{"type":"text","text":", and "},{"type":"codeVoice","code":"ResolvedDocument"},{"type":"text","text":")"},{"type":"text","text":" "},{"type":"text","text":"each allow you to get complete information about the respective components"},{"type":"text","text":" "},{"type":"text","text":"without looking to other parts of the document."}],"type":"paragraph"},{"inlineContent":[{"inlineContent":[{"text":"Example","type":"text"}],"type":"strong"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"You want to know what all of the parameters for a particular "},{"code":"PATCH","type":"codeVoice"},{"type":"text","text":" endpoint are."},{"type":"text","text":" "},{"type":"text","text":"Without the "},{"code":"ResolvedEndpoint","type":"codeVoice"},{"type":"text","text":" type, you would need to look at the"},{"type":"text","text":" "},{"code":"OpenAPI.Operation","type":"codeVoice"},{"type":"text","text":" representing the endpoint, the "},{"code":"OpenAPI.PathItem","type":"codeVoice"},{"type":"text","text":" "},{"type":"text","text":"representing the route containing the endpoint, and you would need to potentially"},{"type":"text","text":" "},{"type":"text","text":"resolve references to the "},{"code":"OpenAPI.Components","type":"codeVoice"},{"type":"text","text":"."}],"type":"paragraph"},{"inlineContent":[{"text":"With ","type":"text"},{"code":"ResolvedDocument","type":"codeVoice"},{"text":", the same task is much simpler:","type":"text"}],"type":"paragraph"},{"code":["let document: OpenAPI.Document = ...","","let resolvedDocument = try document","    .locallyDereferenced()","    .resolved()","","let endpoint = resolvedDocument","    .routesByPath[\"\/example\/path\"]!.patch!","","\/\/ This will be all parameters defined anywhere that","\/\/ apply to this endpoint:","let parameters = endpoint.parameters"],"type":"codeListing","syntax":null}]}],"variants":[{"paths":["\/documentation\/openapikit\/resolveddocument"],"traits":[{"interfaceLanguage":"swift"}]}],"references":{"doc://OpenAPIKit/documentation/OpenAPIKit/ResolvedDocument":{"abstract":[{"text":"A resolved document is a fully dereferenced","type":"text"},{"text":" ","type":"text"},{"text":"OpenAPI document that has been further distilled","type":"text"},{"text":" ","type":"text"},{"text":"to canonical representations of each component. You","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"create a "},{"code":"ResolvedDocument","type":"codeVoice"},{"type":"text","text":" by calling the "},{"code":"resolved()","type":"codeVoice"},{"type":"text","text":" "},{"type":"text","text":"method on a "},{"code":"DereferencedDocument","type":"codeVoice"},{"type":"text","text":"."}]