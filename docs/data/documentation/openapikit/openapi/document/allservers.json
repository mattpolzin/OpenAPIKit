{"abstract":[{"type":"text","text":"All servers referenced anywhere in the whole document."}],"kind":"symbol","schemaVersion":{"major":0,"patch":0,"minor":3},"sections":[],"identifier":{"url":"doc:\/\/OpenAPIKit\/documentation\/OpenAPIKit\/OpenAPI\/Document\/allServers","interfaceLanguage":"swift"},"hierarchy":{"paths":[["doc:\/\/OpenAPIKit\/documentation\/OpenAPIKit","doc:\/\/OpenAPIKit\/documentation\/OpenAPIKit\/OpenAPI","doc:\/\/OpenAPIKit\/documentation\/OpenAPIKit\/OpenAPI\/Document"]]},"primaryContentSections":[{"kind":"declarations","declarations":[{"languages":["swift"],"tokens":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"allServers"},{"kind":"text","text":": ["},{"kind":"typeIdentifier","identifier":"doc:\/\/OpenAPIKit\/documentation\/OpenAPIKit\/OpenAPI","preciseIdentifier":"s:10OpenAPIKit0A3APIO","text":"OpenAPI"},{"kind":"text","text":"."},{"kind":"typeIdentifier","identifier":"doc:\/\/OpenAPIKit\/documentation\/OpenAPIKit\/OpenAPI\/Server","preciseIdentifier":"s:10OpenAPIKit0A3APIO6ServerV","text":"Server"},{"kind":"text","text":"] { "},{"kind":"keyword","text":"get"},{"kind":"text","text":" }"}],"platforms":["Linux"]}]},{"kind":"content","content":[{"anchor":"discussion","text":"Discussion","level":2,"type":"heading"},{"inlineContent":[{"text":"This property contains all servers defined at any level the document","type":"text"},{"text":" ","type":"text"},{"text":"and therefore may or may not contain servers not found in the","type":"text"},{"text":" ","type":"text"},{"text":"root servers array.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"The "},{"type":"codeVoice","code":"servers"},{"type":"text","text":" property on "},{"type":"codeVoice","code":"OpenAPI.Document"},{"type":"text","text":", by contrast, contains"},{"type":"text","text":" "},{"type":"text","text":"servers that are applicable to all paths and operations that"},{"type":"text","text":" "},{"type":"text","text":"do not define their own "},{"type":"codeVoice","code":"serves"},{"type":"text","text":" array to override the root array."}],"type":"paragraph"},{"content":[{"inlineContent":[{"type":"text","text":"For the purposes of returning one of each "},{"type":"codeVoice","code":"Server"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"text","text":"two servers are considered identical if they have the same "},{"type":"codeVoice","code":"url"},{"type":"text","text":" "},{"type":"text","text":"and "},{"type":"codeVoice","code":"variables"},{"type":"text","text":". Differing "},{"type":"codeVoice","code":"description"},{"type":"text","text":" properties for"},{"type":"text","text":" "},{"type":"text","text":"otherwise identical servers are considered to be two ways to"},{"type":"text","text":" "},{"type":"text","text":"describe the same server. "},{"type":"codeVoice","code":"vendorExtensions"},{"type":"text","text":" are also"},{"type":"text","text":" "},{"type":"text","text":"ignored when determining server uniqueness."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"The first "},{"type":"codeVoice","code":"Server"},{"type":"text","text":" encountered will be used, so if the only"},{"type":"text","text":" "},{"type":"text","text":"difference between a server at the root document level and"},{"type":"text","text":" "},{"type":"text","text":"one in an "},{"type":"codeVoice","code":"Operation"},{"type":"text","text":"’s override of the servers array is the"},{"type":"text","text":" "},{"type":"text","text":"description, the description of the "},{"type":"codeVoice","code":"Server"},{"type":"text","text":" returned by this"},{"type":"text","text":" "},{"type":"text","text":"property will be that of the root document definition."}],"type":"paragraph"}],"name":"Important","style":"important","type":"aside"}]}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/openapikit\/openapi\/document\/allservers"]}],"metadata":{"fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"allServers"},{"kind":"text","text":": ["},{"kind":"typeIdentifier","text":"OpenAPI","preciseIdentifier":"s:10OpenAPIKit0A3APIO"},{"kind":"text","text":"."},{"kind":"typeIdentifier","text":"Server","preciseIdentifier":"s:10OpenAPIKit0A3APIO6ServerV"},{"kind":"text","text":"]"}],"title":"allServers","roleHeading":"Instance Property","modules":[{"name":"OpenAPIKit"}],"externalID":"s:10OpenAPIKit0A3APIO8DocumentV10allServersSayAC6ServerVGvp","role":"symbol","extendedModule":"OpenAPIKit","symbolKind":"property"},"references":{"doc://OpenAPIKit/documentation/OpenAPIKit/OpenAPI":{"abstract":[{"text":"The OpenAPI namespace","type":"text"}],"kind":"symbol","title":"OpenAPI","fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"OpenAPI","kind":"identifier"}],"role":"symbol","url":"\/documentation\/openapikit\/openapi","identifier":"doc:\/\/OpenAPIKit\/documentation\/OpenAPIKit\/OpenAPI","type":"topic","navigatorTitle":[{"text":"OpenAPI","kind":"identifier"}]},"doc://OpenAPIKit/documentation/OpenAPIKit/OpenAPI/Document":{"identifier":"doc:\/\/OpenAPIKit\/documentation\/OpenAPIKit\/OpenAPI\/Document","title":"OpenAPI.Document","abstract":[{"type":"text","text":"The root of an OpenAPI 3.1 document."}],"role":"symbol","url":"\/documentation\/openapikit\/openapi\/document","navigatorTitle":[{"kind":"identifier","text":"Document"}],"kind":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Document"}],"type":"topic"},"doc://OpenAPIKit/documentation/OpenAPIKit/OpenAPI/Document/allServers":{"url":"\/documentation\/openapikit\/openapi\/document\/allservers","abstract":[{"text":"All servers referenced anywhere in the whole document.","type":"text"}],"identifier":"doc:\/\/OpenAPIKit\/documentation\/OpenAPIKit\/OpenAPI\/Document\/allServers","role":"symbol","title":"allServers","kind":"symbol","type":"topi