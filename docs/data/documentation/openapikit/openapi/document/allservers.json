{"schemaVersion":{"patch":0,"major":0,"minor":3},"abstract":[{"text":"All servers referenced anywhere in the whole document.","type":"text"}],"metadata":{"externalID":"s:10OpenAPIKit0A3APIO8DocumentV10allServersSayAC6ServerVGvp","title":"allServers","modules":[{"name":"OpenAPIKit"}],"roleHeading":"Instance Property","symbolKind":"property","fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"allServers"},{"kind":"text","text":": ["},{"kind":"typeIdentifier","text":"OpenAPI","preciseIdentifier":"s:10OpenAPIKit0A3APIO"},{"kind":"text","text":"."},{"kind":"typeIdentifier","text":"Server","preciseIdentifier":"s:10OpenAPIKit0A3APIO6ServerV"},{"kind":"text","text":"]"}],"role":"symbol","extendedModule":"OpenAPIKit"},"primaryContentSections":[{"declarations":[{"platforms":["Linux"],"tokens":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"allServers"},{"kind":"text","text":": ["},{"kind":"typeIdentifier","text":"OpenAPI","identifier":"doc:\/\/OpenAPIKit\/documentation\/OpenAPIKit\/OpenAPI","preciseIdentifier":"s:10OpenAPIKit0A3APIO"},{"kind":"text","text":"."},{"kind":"typeIdentifier","text":"Server","identifier":"doc:\/\/OpenAPIKit\/documentation\/OpenAPIKit\/OpenAPI\/Server","preciseIdentifier":"s:10OpenAPIKit0A3APIO6ServerV"},{"kind":"text","text":"] { "},{"kind":"keyword","text":"get"},{"kind":"text","text":" }"}],"languages":["swift"]}],"kind":"declarations"},{"content":[{"text":"Discussion","level":2,"anchor":"discussion","type":"heading"},{"inlineContent":[{"text":"This property contains all servers defined at any level the document","type":"text"},{"text":" ","type":"text"},{"text":"and therefore may or may not contain servers not found in the","type":"text"},{"text":" ","type":"text"},{"text":"root servers array.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"The "},{"type":"codeVoice","code":"servers"},{"type":"text","text":" property on "},{"type":"codeVoice","code":"OpenAPI.Document"},{"type":"text","text":", by contrast, contains"},{"type":"text","text":" "},{"type":"text","text":"servers that are applicable to all paths and operations that"},{"type":"text","text":" "},{"type":"text","text":"do not define their own "},{"type":"codeVoice","code":"serves"},{"type":"text","text":" array to override the root array."}],"type":"paragraph"},{"name":"Important","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"For the purposes of returning one of each "},{"type":"codeVoice","code":"Server"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"text","text":"two servers are considered identical if they have the same "},{"type":"codeVoice","code":"url"},{"type":"text","text":" "},{"type":"text","text":"and "},{"type":"codeVoice","code":"variables"},{"type":"text","text":". Differing "},{"type":"codeVoice","code":"description"},{"type":"text","text":" properties for"},{"type":"text","text":" "},{"type":"text","text":"otherwise identical servers are considered to be two ways to"},{"type":"text","text":" "},{"type":"text","text":"describe the same server. "},{"type":"codeVoice","code":"vendorExtensions"},{"type":"text","text":" are also"},{"type":"text","text":" "},{"type":"text","text":"ignored when determining server uniqueness."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The first "},{"type":"codeVoice","code":"Server"},{"type":"text","text":" encountered will be used, so if the only"},{"type":"text","text":" "},{"type":"text","text":"difference between a server at the root document level and"},{"type":"text","text":" "},{"type":"text","text":"one in an "},{"type":"codeVoice","code":"Operation"},{"type":"text","text":"’s override of the servers array is the"},{"type":"text","text":" "},{"type":"text","text":"description, the description of the "},{"type":"codeVoice","code":"Server"},{"type":"text","text":" returned by this"},{"type":"text","text":" "},{"type":"text","text":"property will be that of the root document definition."}]}],"type":"aside","style":"important"}],"kind":"content"}],"identifier":{"url":"doc:\/\/OpenAPIKit\/documentation\/OpenAPIKit\/OpenAPI\/Document\/allServers","interfaceLanguage":"swift"},"variants":[{"paths":["\/documentation\/openapikit\/openapi\/document\/allservers"],"traits":[{"interfaceLanguage":"swift"}]}],"kind":"symbol","hierarchy":{"paths":[["doc:\/\/OpenAPIKit\/documentation\/OpenAPIKit","doc:\/\/OpenAPIKit\/documentation\/OpenAPIKit\/OpenAPI","doc:\/\/OpenAPIKit\/documentation\/OpenAPIKit\/OpenAPI\/Document"]]},"sections":[],"references":{"doc://OpenAPIKit/documentation/OpenAPIKit":{"abstract":[],"identifier":"doc:\/\/OpenAPIKit\/documentation\/OpenAPIKit","kind":"symbol","url":"\/documentation\/openapikit","title":"OpenAPIKit","type":"topic","role":"collection"},"doc://OpenAPIKit/documentation/OpenAPIKit/OpenAPI/Document":{"type":"topic","navigatorTitle":[{"text":"Document","kind":"identifier"}],"identifier":"doc:\/\/OpenAPIKit\/documentation\/OpenAPIKit\/OpenAPI\/Document","kind":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Document","kind":"identifier"}],"title":"OpenAPI.Document","url":"\/documentation\/openapikit\/openapi\/document","abstract":[{"type":"text","text":"The root of an OpenAPI 3.1 document."}],"role":"symbol"},"doc://OpenAPIKit/documentation/OpenAPIKit/OpenAPI/Server":{"url":"\/documentation\/openapikit\/openapi\/server","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Server","kind":"identifier"}],"navigatorTitle":[{"text":"Server","kind":"identifier"}],"type":"topic","identifier":"doc:\/\/OpenAPIKit\/documentation\/OpenAPIKit\/OpenAPI\/Server","title":"OpenAPI.Server","kind":"symbol","role":"symbol","abstract":[{"text":"OpenAPI Spec “Server Object”","type":"text"}]},"doc://OpenAPIKit/documentation/OpenAPIKit/OpenAPI/Document/allServers":{"identifier":"doc:\/\/OpenAPIKit\/documentation\/Op