{"kind":"symbol","sections":[],"metadata":{"modules":[{"name":"OpenAPIKit"}],"externalID":"s:10OpenAPIKit0A3APIO8DocumentV10allServersSayAC6ServerVGvp","title":"allServers","roleHeading":"Instance Property","role":"symbol","extendedModule":"OpenAPIKit","symbolKind":"property","fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"allServers"},{"kind":"text","text":": ["},{"kind":"typeIdentifier","text":"OpenAPI","preciseIdentifier":"s:10OpenAPIKit0A3APIO"},{"kind":"text","text":"."},{"kind":"typeIdentifier","text":"Server","preciseIdentifier":"s:10OpenAPIKit0A3APIO6ServerV"},{"kind":"text","text":"]"}]},"hierarchy":{"paths":[["doc:\/\/OpenAPIKit\/documentation\/OpenAPIKit","doc:\/\/OpenAPIKit\/documentation\/OpenAPIKit\/OpenAPI","doc:\/\/OpenAPIKit\/documentation\/OpenAPIKit\/OpenAPI\/Document"]]},"schemaVersion":{"patch":0,"minor":3,"major":0},"abstract":[{"text":"All servers referenced anywhere in the whole document.","type":"text"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/openapikit\/openapi\/document\/allservers"]}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/OpenAPIKit\/documentation\/OpenAPIKit\/OpenAPI\/Document\/allServers"},"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"allServers","kind":"identifier"},{"text":": [","kind":"text"},{"text":"OpenAPI","identifier":"doc:\/\/OpenAPIKit\/documentation\/OpenAPIKit\/OpenAPI","kind":"typeIdentifier","preciseIdentifier":"s:10OpenAPIKit0A3APIO"},{"text":".","kind":"text"},{"text":"Server","identifier":"doc:\/\/OpenAPIKit\/documentation\/OpenAPIKit\/OpenAPI\/Server","kind":"typeIdentifier","preciseIdentifier":"s:10OpenAPIKit0A3APIO6ServerV"},{"text":"] { ","kind":"text"},{"text":"get","kind":"keyword"},{"text":" }","kind":"text"}],"platforms":["Linux"],"languages":["swift"]}]},{"kind":"content","content":[{"type":"heading","level":2,"text":"Discussion","anchor":"discussion"},{"type":"paragraph","inlineContent":[{"text":"This property contains all servers defined at any level the document","type":"text"},{"text":" ","type":"text"},{"text":"and therefore may or may not contain servers not found in the","type":"text"},{"text":" ","type":"text"},{"text":"root servers array.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The "},{"type":"codeVoice","code":"servers"},{"type":"text","text":" property on "},{"type":"codeVoice","code":"OpenAPI.Document"},{"type":"text","text":", by contrast, contains"},{"type":"text","text":" "},{"type":"text","text":"servers that are applicable to all paths and operations that"},{"type":"text","text":" "},{"type":"text","text":"do not define their own "},{"type":"codeVoice","code":"serves"},{"type":"text","text":" array to override the root array."}]},{"type":"aside","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"For the purposes of returning one of each "},{"code":"Server","type":"codeVoice"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"text","text":"two servers are considered identical if they have the same "},{"code":"url","type":"codeVoice"},{"type":"text","text":" "},{"type":"text","text":"and "},{"code":"variables","type":"codeVoice"},{"type":"text","text":". Differing "},{"code":"description","type":"codeVoice"},{"type":"text","text":" properties for"},{"type":"text","text":" "},{"type":"text","text":"otherwise identical servers are considered to be two ways to"},{"type":"text","text":" "},{"type":"text","text":"describe the same server. "},{"code":"vendorExtensions","type":"codeVoice"},{"type":"text","text":" are also"},{"type":"text","text":" "},{"type":"text","text":"ignored when determining server uniqueness."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The first "},{"code":"Server","type":"codeVoice"},{"type":"text","text":" encountered will be used, so if the only"},{"type":"text","text":" "},{"type":"text","text":"difference between a server at the root document level and"},{"type":"text","text":" "},{"type":"text","text":"one in an "},{"code":"Operation","type":"codeVoice"},{"type":"text","text":"’s override of the servers array is the"},{"type":"text","text":" "},{"type":"text","text":"description, the description of the "},{"code":"Server","type":"codeVoice"},{"type":"text","text":" returned by this"},{"type":"text","text":" "},{"type":"text","text":"property will be that of the root document definition."}]}],"name":"Important","style":"important"}]}],"references":{"doc://OpenAPIKit/documentation/OpenAPIKit/OpenAPI/Document/allServers":{"identifier":"doc:\/\/OpenAPIKit\/documentation\/OpenAPIKit\/OpenAPI\/Document\/allServers","role":"symbol","fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"allServers"},{"kind":"text","text":": ["},{"kind":"typeIdentifier","preciseIdentifier":"s:10OpenAPIKit0A3APIO","text":"OpenAPI"},{"kind":"text","text":"."},{"kind":"typeIdentifier","preciseIdentifier":"s:10OpenAPIKit0A3APIO6ServerV","text":"Server"},{"kind":"text","text":"]"}],"abstract":[{"type":"text","text":"All servers referenced anywhere in the whole document."}],"kind":"symbol","type":"topic","url":"\/documentation\/openapikit\/openapi\/document\/allservers","title":"allServers"},"doc://OpenAPIKit/documentation/OpenAPIKit/OpenAPI":{"kind":"symbol","role":"symbol","fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"OpenAPI","kind":"identifier"}],"title":"OpenAPI","navigatorTitle":[{"text":"OpenAPI","kind":"identifier"}],"identifier":"doc:\/\/OpenAPIKit\/documentation\/OpenAPIKit\/OpenAPI","type":"topic","abstract":[{"text":"The OpenAPI namespace","type":"text"}],"url":"\/documentation\/openapikit\/openapi"},"doc://OpenAPIKit/documentation/OpenAPIKit":{"kind":"symbol","role":"collection","title":"OpenAPIKit","identifier":"doc:\/\/OpenAPIKit\/doc