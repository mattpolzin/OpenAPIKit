ription of the "},{"type":"codeVoice","code":"Server"},{"type":"text","text":" returned by this"},{"type":"text","text":" "},{"type":"text","text":"property will be that of the root document definition."}],"type":"paragraph"}]}]}],"kind":"symbol","variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/openapikit\/openapi\/document\/allservers"]}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/OpenAPIKit\/documentation\/OpenAPIKit\/OpenAPI\/Document\/allServers"},"sections":[],"abstract":[{"type":"text","text":"All servers referenced anywhere in the whole document."}],"references":{"doc://OpenAPIKit/documentation/OpenAPIKit/OpenAPI/Server":{"abstract":[{"type":"text","text":"OpenAPI Spec “Server Object”"}],"kind":"symbol","url":"\/documentation\/openapikit\/openapi\/server","title":"OpenAPI.Server","role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Server","kind":"identifier"}],"identifier":"doc:\/\/OpenAPIKit\/documentation\/OpenAPIKit\/OpenAPI\/Server","navigatorTitle":[{"text":"Server","kind":"identifier"}],"type":"topic"},"doc://OpenAPIKit/documentation/OpenAPIKit":{"abstract":[],"identifier":"doc:\/\/OpenAPIKit\/documentation\/OpenAPIKit","url":"\/documentation\/openapikit","type":"topic","kind":"symbol","role":"collection","title":"OpenAPIKit"},"doc://OpenAPIKit/documentation/OpenAPIKit/OpenAPI/Document/allServers":{"fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"allServers","kind":"identifier"},{"text":": [","kind":"text"},{"text":"OpenAPI","kind":"typeIdentifier","preciseIdentifier":"s:10OpenAPIKit0A3APIO"},{"text":".","kind":"text"},{"text":"Server","kind":"typeIdentifier","preciseIdentifier":"s:10OpenAPIKit0A3APIO6ServerV"},{"text":"]","kind":"text"}],"title":"allServers","type":"topic","kind":"symbol","role":"symbol","abstract":[{"type":"text","text":"All servers referenced anywhere in the whole document."}],"identifier":"doc:\/\/OpenAPIKit\