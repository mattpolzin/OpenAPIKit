":"text"},{"code":"url","type":"codeVoice"},{"text":" ","type":"text"},{"text":"and ","type":"text"},{"code":"variables","type":"codeVoice"},{"text":". Differing ","type":"text"},{"code":"description","type":"codeVoice"},{"text":" properties for","type":"text"},{"text":" ","type":"text"},{"text":"otherwise identical servers are considered to be two ways to","type":"text"},{"text":" ","type":"text"},{"text":"describe the same server. ","type":"text"},{"code":"vendorExtensions","type":"codeVoice"},{"text":" are also","type":"text"},{"text":" ","type":"text"},{"text":"ignored when determining server uniqueness.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The first "},{"code":"Server","type":"codeVoice"},{"type":"text","text":" encountered will be used, so if the only"},{"type":"text","text":" "},{"type":"text","text":"difference between a server at the root document level and"},{"type":"text","text":" "},{"type":"text","text":"one in an "},{"code":"Operation","type":"codeVoice"},{"type":"text","text":"’s override of the servers array is the"},{"type":"text","text":" "},{"type":"text","text":"description, the description of the "},{"code":"Server","type":"codeVoice"},{"type":"text","text":" returned by this"},{"type":"text","text":" "},{"type":"text","text":"property will be that of the root document definition."}]}]}]}],"abstract":[{"type":"text","text":"All servers referenced anywhere in the whole document."}],"kind":"symbol","metadata":{"title":"allServers","extendedModule":"OpenAPIKit","role":"symbol","symbolKind":"property","fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"allServers","kind":"identifier"},{"text":": [","kind":"text"},{"preciseIdentifier":"s:10OpenAPIKit0A3APIO","text":"OpenAPI","kind":"typeIdentifier"},{"text":".","kind":"text"},{"preciseIdentifier":"s:10OpenAPIKit0A3APIO6ServerV","text":"Server","kind":"typeIdentifier"},{"text":"]","kind":"text"}],"externalID":"s:10OpenAPIKit0A3APIO8