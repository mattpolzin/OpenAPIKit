on is told what Decodable thing it wants, so you really just","type":"text"},{"text":" ","type":"text"},{"text":"need to decide what decoder to use and provide the file data to that","type":"text"},{"text":" ","type":"text"},{"text":"decoder. See ","type":"text"},{"type":"codeVoice","code":"ExternalLoader"},{"text":" documentation for details.","type":"text"}],"type":"paragraph"}]}],"kind":"symbol","abstract":[{"type":"text","text":"Load all remote references into the document. A remote reference is one"},{"type":"text","text":" "},{"type":"text","text":"that points to another file rather than a location within the"},{"type":"text","text":" "},{"type":"text","text":"same file."}],"schemaVersion":{"patch":0,"minor":3,"major":0},"metadata":{"extendedModule":"OpenAPIKit","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"externallyDereference","kind":"identifier"},{"text":"<","kind":"text"},{"text":"Loader","kind":"genericParameter"},{"text":">(","kind":"text"},{"text":"with","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Loader","kind":"typeIdentifier"},{"text":".Type, ","kind":"text"},{"text":"depth","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"ExternalDereferenceDepth","preciseIdentifier":"s:10OpenAPIKit24ExternalDereferenceDepthO","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"context","kind":"externalParam"},{"text":": [","kind":"text"},{"text":"Loader","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Message","preciseIdentifier":"s:10OpenAPIKit14ExternalLoaderP7MessageQa","kind":"typeIdentifier"},{"text":"]) ","kind":"text"},{"text":"async","kind":"keyword"},{"text":" ","kind":"text"},{"text":"throws","kind":"keyword"},{"text":" -> [","kind":"text"},{"text":"Loader","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Message","preciseIdentifier":"s:10OpenAPIKit14ExternalLoaderP7MessageQa","kind":"typeIdentifier"},{"text":"]","kind":"text"}],"title":"externallyDerefere