kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"externallyDereference"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"Loader"},{"kind":"text","text":">("},{"kind":"externalParam","text":"with"},{"kind":"text","text":" "},{"kind":"internalParam","text":"loader"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Loader"},{"kind":"text","text":".Type, "},{"kind":"externalParam","text":"depth"},{"kind":"text","text":": "},{"identifier":"doc:\/\/OpenAPIKit\/documentation\/OpenAPIKit\/ExternalDereferenceDepth","kind":"typeIdentifier","text":"ExternalDereferenceDepth","preciseIdentifier":"s:10OpenAPIKit24ExternalDereferenceDepthO"},{"kind":"text","text":" = .iterations(1), "},{"kind":"externalParam","text":"context"},{"kind":"text","text":": ["},{"kind":"typeIdentifier","text":"Loader"},{"kind":"text","text":"."},{"identifier":"doc:\/\/OpenAPIKit\/documentation\/OpenAPIKit\/ExternalLoader\/Message","kind":"typeIdentifier","text":"Message","preciseIdentifier":"s:10OpenAPIKit14ExternalLoaderP7MessageQa"},{"kind":"text","text":"] = []) "},{"kind":"keyword","text":"async"},{"kind":"text","text":" "},{"kind":"keyword","text":"throws"},{"kind":"text","text":" -> ["},{"kind":"typeIdentifier","text":"Loader"},{"kind":"text","text":"."},{"identifier":"doc:\/\/OpenAPIKit\/documentation\/OpenAPIKit\/ExternalLoader\/Message","kind":"typeIdentifier","text":"Message","preciseIdentifier":"s:10OpenAPIKit14ExternalLoaderP7MessageQa"},{"kind":"text","text":"] "},{"kind":"keyword","text":"where"},{"kind":"text","text":" "},{"kind":"typeIdentifier","text":"Loader"},{"kind":"text","text":" : "},{"identifier":"doc:\/\/OpenAPIKit\/documentation\/OpenAPIKit\/ExternalLoader","kind":"typeIdentifier","text":"ExternalLoader","preciseIdentifier":"s:10OpenAPIKit14ExternalLoaderP"}],"platforms":["Linux"],"languages":["swift"]}],"kind":"declarations"},{"content":[{"level":2,"type":"heading","text":"Discussion","anchor":"discussion"},{"type":"paragraph","inlineContent":[{"type":"text","text":"This function will load remote references into the Components object"},{"type":"text","text":" "},{"type":"text","text":"and replace the remote reference with a local reference to that component."},{"type":"text","text":" "},{"type":"text","text":"No local references are modified or resolved by this function. You can"},{"type":"text","text":" "},{"type":"text","text":"call "},{"code":"locallyDereferenced()","type":"codeVoice"},{"type":"text","text":" on the externally dereferenced document if"},{"type":"text","text":" "},{"type":"text","text":"you want to also remove local references by inlining all of them."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Externally dereferencing a document requires that you provide both a"},{"type":"text","text":" "},{"type":"text","text":"function that produces a "},{"code":"OpenAPI.ComponentKey","type":"codeVoice"},{"type":"text","text":" for any given remote"},{"type":"text","text":" "},{"type":"text","text":"file URI and also a function that loads and decodes the data found in"},{"type":"text","text":" "},{"type":"text","text":"that remote file. The latter is less work than it may sound like because"},{"type":"text","text":" "},{"type":"text","text":"the function is told what Decodable thing it wants, so you really just"},{"type":"text","text":" "},{"type":"text","text":"need to decide what decoder to use and provide the file data to that"},{"type":"text","text":" "},{"type":"text","text":"decoder. See "},{"code":"ExternalLoader","type":"codeVoice"},{"type":"text","text":" documentation for details."}]}],"kind":"content"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/openapikit\/openapi\/document\/externallydereference(with:depth:context:)"]}],"identifier":{"url":"doc:\/\/OpenAPIKit\/documentation\/OpenAPIKit\/OpenAPI\/Document\/externallyDereference(with:depth:context:)","interfaceLanguage":"swift"},"abstract":[{"type":"text","text":"Load all remote references into the document. A remote reference is one"},{"type":"text","text":" "},{"type":"text","text":"that points to another file rather than a location within the"},{"type":"text","text":" "},{"type":"text","text":"same file."}],"sections":[],"references":{"doc://OpenAPIKit/documentation/OpenAPIKit/OpenAPI/Document":{"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Document"}],"navigatorTitle":[{"kind":"identifier","text":"Document"}],"title":"OpenAPI.Document","abstract":[{"type":"text","text":"The root of an OpenAPI 3.1 document."}],"identifier":"doc:\/\/OpenAPIKit\/documentation\/OpenAPIKit\/OpenAPI\/Document","type":"topic","url":"\/documentation\/openapikit\/openapi\/document","kind":"symbol","role":"symbol"},"doc://OpenAPIKit/documentation/OpenAPIKit/ExternalLoader/Message":{"url":"\/documentation\/openapikit\/externalloader\/message","kind":"symbol","role":"symbol","identifier":"doc:\/\/OpenAPIKit\/documentation\/OpenAPIKit\/ExternalLoader\/Message","fragments":[{"text":"associatedtype","kind":"keyword"},{"text":" ","kind":"text"},{"kind":"identifier","text":"Message"},{"kind":"text","text":" : "},{"preciseIdentifier":"s:s8SendableP","kind":"typeIdentifier","text":"Sendable"}],"required":true,"abstract":[{"text":"This can be anything that an implementor of this protocol wants to pass back from","type":"text"},{"text":" ","type":"text"},{"text":"the ","type":"text"},{"code":"load()","type":"codeVoice"},{"text":" function and have available after all external loading has been done.","type":"text"}],"type":"topic","title":"Message"},"doc://OpenAPIKit/documentation/OpenAPIKit/ExternalLoader":{"url":"\/documentation\/openapikit\/externalloader","kind":"symbol","role":"symbol","navigatorTitle":[{"kind":"identifier","text":"ExternalLoader"}],"identifier":"doc:\/\/OpenAPIKit\/documentation\/OpenAPIKit\/ExternalLoader","fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"ExternalLoader"}],"abstract":[{"type":"text","text":"An "},{"type":"codeVoice","code":"ExternalLoader"},{"type":"text","text":" enables "},{"type":"codeVoice","code":"OpenAPIKit"},{"type":"text","text":" to load external references"},{"type":"text","text":" "},{"text":"without knowing the details of what decoder is being used or how new internal","type":"text"},{"text":" ","type":"text"},{"text":"references should be named.","type":"text"}],"type":"topic","title":"ExternalLoader"},"doc://OpenAPIKit/documentation/OpenAPIKit/OpenAPI/Document/externallyDereference(with:depth:context:)":{"title":"externallyDereference(with:depth:context:)","kind":"symbol","type":"topic","role":"symbol","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"externallyDereference"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"Loader"},{"kind":"text","text":">("},{"kind":"externalParam","text":"with"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Loader"},{"kind":"text","text":".Type, "},{"kind":"externalParam","text":"depth"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"ExternalDereferenceDepth","preciseIdentifier":"s:10OpenAPIKit24ExternalDereferenceDepthO"},{"kind":"text","text":", "},{"kind":"externalParam","text":"context"},{"kind":"text","text":": ["},{"kind":"typeIdentifier","text":"Loader"},{"kind":"text","text":"."},{"kind":"typeIdentifier","text":"Message","preciseIdentifier":"s:10OpenAPIKit14ExternalLoaderP7MessageQa"},{"kind":"text","text":"]) "},{"kind":"keyword","text":"async"},{"kind":"text","text":" "},{"kind":"keyword","text":"throws"},{"kind":"text","text":" -> ["},{"kind":"typeIdentifier","text":"Loader"},{"kind":"text","text":"."},{"kind":"typeIdentifier","text":"Message","preciseIdentifier":"s:10OpenAPIKit14ExternalLoaderP7MessageQa"},{"kind":"text","text":"]"}],"url":"\/documentation\/openapikit\/openapi\/document\/externallyderef