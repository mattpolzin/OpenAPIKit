{"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/OpenAPIKit\/documentation\/OpenAPIKit\/OpenAPI\/Document\/externallyDereference(with:depth:context:)"},"abstract":[{"type":"text","text":"Load all remote references into the document. A remote reference is one"},{"type":"text","text":" "},{"type":"text","text":"that points to another file rather than a location within the"},{"type":"text","text":" "},{"type":"text","text":"same file."}],"schemaVersion":{"patch":0,"major":0,"minor":3},"variants":[{"paths":["\/documentation\/openapikit\/openapi\/document\/externallydereference(with:depth:context:)"],"traits":[{"interfaceLanguage":"swift"}]}],"kind":"symbol","primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"text":"@discardableResult","kind":"attribute"},{"text":" ","kind":"text"},{"text":"mutating","kind":"keyword"},{"text":" ","kind":"text"},{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"externallyDereference","kind":"identifier"},{"text":"<","kind":"text"},{"text":"Loader","kind":"genericParameter"},{"text":">(","kind":"text"},{"text":"with","kind":"externalParam"},{"text":" ","kind":"text"},{"text":"loader","kind":"internalParam"},{"text":": ","kind":"text"},{"text":"Loader","kind":"typeIdentifier"},{"text":".Type, ","kind":"text"},{"text":"depth","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"ExternalDereferenceDepth","kind":"typeIdentifier","identifier":"doc:\/\/OpenAPIKit\/documentation\/OpenAPIKit\/ExternalDereferenceDepth","preciseIdentifier":"s:10OpenAPIKit24ExternalDereferenceDepthO"},{"text":" = .iterations(1), ","kind":"text"},{"text":"context","kind":"externalParam"},{"text":": [","kind":"text"},{"text":"Loader","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Message","kind":"typeIdentifier","identifier":"doc:\/\/OpenAPIKit\/documentation\/OpenAPIKit\/ExternalLoader\/Message","preciseIdentifier":"s:10OpenAPIKit14ExternalLoaderP7MessageQa"},{"text":"] = []) ","kind":"text"},