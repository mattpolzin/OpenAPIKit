type":"text","text":"file URI and also a function that loads and decodes the data found in"},{"type":"text","text":" "},{"type":"text","text":"that remote file. The latter is less work than it may sound like because"},{"type":"text","text":" "},{"type":"text","text":"the function is told what Decodable thing it wants, so you really just"},{"type":"text","text":" "},{"type":"text","text":"need to decide what decoder to use and provide the file data to that"},{"type":"text","text":" "},{"type":"text","text":"decoder. See "},{"type":"codeVoice","code":"ExternalLoader"},{"type":"text","text":" documentation for details."}]}]}],"schemaVersion":{"minor":3,"major":0,"patch":0},"sections":[],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/openapikit\/openapi\/document\/externallydereference(with:depth:context:)"]}],"kind":"symbol","hierarchy":{"paths":[["doc:\/\/OpenAPIKit\/documentation\/OpenAPIKit","doc:\/\/OpenAPIKit\/documentation\/OpenAPIKit\/OpenAPI","doc:\/\/OpenAPIKit\/documentation\/OpenAPIKit\/OpenAPI\/Document"]]},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/OpenAPIKit\/documentation\/OpenAPIKit\/OpenAPI\/Document\/externallyDereference(with:depth:context:)"},"metadata":{"externalID":"s:10OpenAPIKit0A3APIO8DocumentV21externallyDereference4with5depth7contextSay7MessageQzGxm_AA08ExternalF5DepthOALtYaKAA0K6LoaderRzlF","extendedModule":"OpenAPIKit","role":"symbol","symbolKind":"method","roleHeading":"Instance Method","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"externallyDereference","kind":"identifier"},{"text":"<","kind":"text"},{"text":"Loader","kind":"genericParameter"},{"text":">(","kind":"text"},{"text":"with","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Loader","preciseIdentifier":"s:10OpenAPIKit0A3APIO8DocumentV21externallyDereference4with5depth7contextSay7MessageQzGxm_AA08ExternalF5DepthOALtYaKAA0K6LoaderRzlF0M0L_xmfp","kind":"typeIdentifier"},{"text":".Type, ",