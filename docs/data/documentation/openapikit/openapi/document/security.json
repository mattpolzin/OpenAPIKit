at reason, OpenAPIKit defines keys in security requirement objects as"},{"type":"text","text":" "},{"type":"text","text":"explicit references to entries in the Components Object instead of "},{"code":"String","type":"codeVoice"},{"type":"text","text":" "},{"type":"text","text":"values."}],"type":"paragraph"}],"type":"aside","style":"important"}]}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/openapikit\/openapi\/document\/security"]}],"identifier":{"url":"doc:\/\/OpenAPIKit\/documentation\/OpenAPIKit\/OpenAPI\/Document\/security","interfaceLanguage":"swift"},"kind":"symbol","sections":[],"schemaVersion":{"major":0,"patch":0,"minor":3},"abstract":[{"type":"text","text":"A declaration of which security mechanisms can be used across the API."}],"metadata":{"externalID":"s:10OpenAPIKit0A3APIO8DocumentV8securitySaySDyAA13JSONReferenceOyAC14SecuritySchemeVGSaySSGGGvp","role":"symbol","title":"security","modules":[{"name":"OpenAPIKit"}],"roleHeading":"Instance Property","symbolKind":"property","fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"security","kind":"identifier"},{"text":": [","kind":"text"},{"text":"OpenAPI","kind":"typeIdentifier","preciseIdentifier":"s:10OpenAPIKit0A3APIO"},{"text":".","kind":"text"},{"text":"SecurityRequirement","kind":"typeIdentifier","preciseIdentifier":"s:10OpenAPIKit0A3APIO19SecurityRequirementa"},{"text":"]","kind":"text"}]},"hierarchy":{"paths":[["doc:\/\/OpenAPIKit\/documentation\/OpenAPIKit","doc:\/\/OpenAPIKit\/documentation\/OpenAPIKit\/OpenAPI","doc:\/\/OpenAPIKit\/documentation\/OpenAPIKit\/OpenAPI\/Document"]]},"references":{"doc://OpenAPIKit/documentation/OpenAPIKit/OpenAPI":{"navigatorTitle":[{"text":"OpenAPI","kind":"identifier"}],"title":"OpenAPI","abstract":[{"text":"The OpenAPI namespace","type":"text"}],"role":"symbol","kind":"symbol","fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"OpenAPI","kind":"identifier"}],"identifier