ize a request. Individual operations can override this definition.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"To make security optional, an empty security requirement can be included"},{"type":"text","text":" "},{"type":"text","text":"in the array."}],"type":"paragraph"},{"type":"aside","style":"important","content":[{"inlineContent":[{"type":"text","text":"The OpenAPI Specification defines Security Requirement"},{"type":"text","text":" "},{"type":"text","text":"Object keys as being "},{"type":"codeVoice","code":"String"},{"type":"text","text":" values corresponding to entries in"},{"type":"text","text":" "},{"type":"text","text":"the Components Object."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"OpenAPIKit has a type capable of representing that: The "},{"type":"codeVoice","code":"JSONReference"},{"type":"text","text":"."},{"type":"text","text":" "},{"type":"text","text":"For that reason, OpenAPIKit defines keys in security requirement objects as"},{"type":"text","text":" "},{"type":"text","text":"explicit references to entries in the Components Object instead of "},{"type":"codeVoice","code":"String"},{"type":"text","text":" "},{"type":"text","text":"values."}],"type":"paragraph"}],"name":"Important"}]}],"abstract":[{"type":"text","text":"A declaration of which security mechanisms can be used across the API."}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/OpenAPIKit\/documentation\/OpenAPIKit\/OpenAPI\/Document\/security"},"variants":[{"paths":["\/documentation\/openapikit\/openapi\/document\/security"],"traits":[{"interfaceLanguage":"swift"}]}],"references":{"doc://OpenAPIKit/documentation/OpenAPIKit":{"type":"topic","kind":"symbol","identifier":"doc:\/\/OpenAPIKit\/documentation\/OpenAPIKit","abstract":[],"title":"OpenAPIKit","url":"\/documentation\/openapikit","role":"collection"},"doc://OpenAPIKit/documentation/OpenAPIKit/OpenAPI":{"identifier":"doc:\/\/OpenAPIKit\/documentation\/OpenAPIKit\/Op