nt","type":"text"},{"text":" ","type":"text"},{"text":"Object keys as being ","type":"text"},{"code":"String","type":"codeVoice"},{"text":" values corresponding to entries in","type":"text"},{"text":" ","type":"text"},{"text":"the Components Object.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"OpenAPIKit has a type capable of representing that: The "},{"type":"codeVoice","code":"JSONReference"},{"type":"text","text":"."},{"type":"text","text":" "},{"type":"text","text":"For that reason, OpenAPIKit defines keys in security requirement objects as"},{"type":"text","text":" "},{"type":"text","text":"explicit references to entries in the Components Object instead of "},{"type":"codeVoice","code":"String"},{"type":"text","text":" "},{"type":"text","text":"values."}],"type":"paragraph"}]}],"kind":"content"}],"abstract":[{"text":"A declaration of which security mechanisms can be used across the API.","type":"text"}],"hierarchy":{"paths":[["doc:\/\/OpenAPIKit\/documentation\/OpenAPIKit","doc:\/\/OpenAPIKit\/documentation\/OpenAPIKit\/OpenAPI","doc:\/\/OpenAPIKit\/documentation\/OpenAPIKit\/OpenAPI\/Document"]]},"schemaVersion":{"patch":0,"minor":3,"major":0},"kind":"symbol","identifier":{"interfaceLanguage":"swift","url":"doc:\/\/OpenAPIKit\/documentation\/OpenAPIKit\/OpenAPI\/Document\/security"},"references":{"doc://OpenAPIKit/documentation/OpenAPIKit/OpenAPI/Document":{"type":"topic","navigatorTitle":[{"text":"Document","kind":"identifier"}],"identifier":"doc:\/\/OpenAPIKit\/documentation\/OpenAPIKit\/OpenAPI\/Document","kind":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Document","kind":"identifier"}],"title":"OpenAPI.Document","url":"\/documentation\/openapikit\/openapi\/document","abstract":[{"type":"text","text":"The root of an OpenAPI 3.1 document."}],"role":"symbol"},"doc://OpenAPIKit/documentation/OpenAPIKit/OpenAPI":{"kind":"symbol","type":"topic","identifier":"doc:\/\/OpenAPIKit\/doc