 requirement objects that can","type":"text"},{"text":" ","type":"text"},{"text":"be used. Only one of the security requirement objects need to be satisfied","type":"text"},{"text":" ","type":"text"},{"text":"to authorize a request. Individual operations can override this definition.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"To make security optional, an empty security requirement can be included"},{"type":"text","text":" "},{"type":"text","text":"in the array."}],"type":"paragraph"},{"style":"important","content":[{"type":"paragraph","inlineContent":[{"text":"The OpenAPI Specification defines Security Requirement","type":"text"},{"text":" ","type":"text"},{"text":"Object keys as being ","type":"text"},{"code":"String","type":"codeVoice"},{"text":" values corresponding to entries in","type":"text"},{"text":" ","type":"text"},{"text":"the Components Object.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"OpenAPIKit has a type capable of representing that: The "},{"type":"codeVoice","code":"JSONReference"},{"type":"text","text":"."},{"type":"text","text":" "},{"type":"text","text":"For that reason, OpenAPIKit defines keys in security requirement objects as"},{"type":"text","text":" "},{"type":"text","text":"explicit references to entries in the Components Object instead of "},{"type":"codeVoice","code":"String"},{"type":"text","text":" "},{"type":"text","text":"values."}]}],"type":"aside","name":"Important"}],"kind":"content"}],"kind":"symbol","abstract":[{"type":"text","text":"A declaration of which security mechanisms can be used across the API."}],"references":{"doc://OpenAPIKit/documentation/OpenAPIKit":{"abstract":[],"identifier":"doc:\/\/OpenAPIKit\/documentation\/OpenAPIKit","url":"\/documentation\/openapikit","type":"topic","kind":"symbol","role":"collection","title":"OpenAPIKit"},"doc://OpenAPIKit/documentation/OpenAPIKit/OpenAPI/Document/security":{"fragments":[{"text":"var","kind":"keyword"},