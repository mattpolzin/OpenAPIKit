{"primaryContentSections":[{"declarations":[{"platforms":["Linux"],"tokens":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"security"},{"kind":"text","text":": ["},{"kind":"typeIdentifier","identifier":"doc:\/\/OpenAPIKit\/documentation\/OpenAPIKit\/OpenAPI","text":"OpenAPI","preciseIdentifier":"s:10OpenAPIKit0A3APIO"},{"kind":"text","text":"."},{"kind":"typeIdentifier","identifier":"doc:\/\/OpenAPIKit\/documentation\/OpenAPIKit\/OpenAPI\/SecurityRequirement","text":"SecurityRequirement","preciseIdentifier":"s:10OpenAPIKit0A3APIO19SecurityRequirementa"},{"kind":"text","text":"]"}],"languages":["swift"]}],"kind":"declarations"},{"content":[{"text":"Discussion","anchor":"discussion","type":"heading","level":2},{"inlineContent":[{"type":"text","text":"The list of values includes alternative security requirement objects that can"},{"type":"text","text":" "},{"type":"text","text":"be used. Only one of the security requirement objects need to be satisfied"},{"type":"text","text":" "},{"type":"text","text":"to authorize a request. Individual operations can override this definition."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"To make security optional, an empty security requirement can be included"},{"type":"text","text":" "},{"type":"text","text":"in the array."}],"type":"paragraph"},{"name":"Important","content":[{"inlineContent":[{"text":"The OpenAPI Specification defines Security Requirement","type":"text"},{"text":" ","type":"text"},{"text":"Object keys as being ","type":"text"},{"code":"String","type":"codeVoice"},{"text":" values corresponding to entries in","type":"text"},{"text":" ","type":"text"},{"text":"the Components Object.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"OpenAPIKit has a type capable of representing that: The "},{"type":"codeVoice","code":"JSONReference"},{"type":"text","text":"."},{"type":"text","text":" "},{"type":"text","text":"For that reason, OpenAPIKit defines keys in security requirement objects as"},{"type":"text","text":" "},{"type":"text","text":"explicit references to entries in the Components Object instead of "},{"type":"codeVoice","code":"String"},{"type":"text","text":" "},{"type":"text","text":"values."}],"type":"paragraph"}],"type":"aside","style":"important"}],"kind":"content"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/openapikit\/openapi\/document\/security"]}],"kind":"symbol","sections":[],"schemaVersion":{"major":0,"patch":0,"minor":3},"hierarchy":{"paths":[["doc:\/\/OpenAPIKit\/documentation\/OpenAPIKit","doc:\/\/OpenAPIKit\/documentation\/OpenAPIKit\/OpenAPI","doc:\/\/OpenAPIKit\/documentation\/OpenAPIKit\/OpenAPI\/Document"]]},"identifier":{"url":"doc:\/\/OpenAPIKit\/documentation\/OpenAPIKit\/OpenAPI\/Document\/security","interfaceLanguage":"swift"},"abstract":[{"text":"A declaration of which security mechanisms can be used across the API.","type":"text"}],"metadata":{"externalID":"s:10OpenAPIKit0A3APIO8DocumentV8securitySaySDyAA13JSONReferenceOyAC14SecuritySchemeVGSaySSGGGvp","symbolKind":"property","roleHeading":"Instance Property","title":"security","role":"symbol","fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"security"},{"kind":"text","text":": ["},{"preciseIdentifier":"s:10OpenAPIKit0A3APIO","kind":"typeIdentifier","text":"OpenAPI"},{"kind":"text","text":"."},{"preciseIdentifier":"s:10OpenAPIKit0A3APIO19SecurityRequirementa","kind":"typeIdentifier","text":"SecurityRequirement"},{"kind":"text","text":"]"}],"modules":[{"name":"OpenAPIKit"}]},"references":{"doc://OpenAPIKit/documentation/OpenAPIKit/OpenAPI":{"fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"OpenAPI"}],"abstract":[{"text":"The OpenAPI namespace","type":"text"}],"identifier":"doc:\/\/OpenAPIKit\/documentation\/OpenAPIKit\/OpenAPI","type":"topic","kind":"symbol","role":"symbol","u