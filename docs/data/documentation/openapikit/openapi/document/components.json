{"abstract":[{"text":"Storage for components that need to be referenced elsewhere in the","type":"text"},{"text":" ","type":"text"},{"text":"OpenAPI Document using ","type":"text"},{"code":"OpenAPI.References","type":"codeVoice"},{"text":".","type":"text"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/openapikit\/openapi\/document\/components"]}],"identifier":{"url":"doc:\/\/OpenAPIKit\/documentation\/OpenAPIKit\/OpenAPI\/Document\/components","interfaceLanguage":"swift"},"metadata":{"role":"symbol","modules":[{"name":"OpenAPIKit"}],"title":"components","roleHeading":"Instance Property","symbolKind":"property","externalID":"s:10OpenAPIKit0A3APIO8DocumentV10componentsAC10ComponentsVvp","fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"components"},{"kind":"text","text":": "},{"preciseIdentifier":"s:10OpenAPIKit0A3APIO","kind":"typeIdentifier","text":"OpenAPI"},{"kind":"text","text":"."},{"preciseIdentifier":"s:10OpenAPIKit0A3APIO10ComponentsV","kind":"typeIdentifier","text":"Components"}]},"schemaVersion":{"patch":0,"major":0,"minor":3},"hierarchy":{"paths":[["doc:\/\/OpenAPIKit\/documentation\/OpenAPIKit","doc:\/\/OpenAPIKit\/documentation\/OpenAPIKit\/OpenAPI","doc:\/\/OpenAPIKit\/documentation\/OpenAPIKit\/OpenAPI\/Document"]]},"primaryContentSections":[{"declarations":[{"platforms":["Linux"],"tokens":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"components"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"OpenAPI","preciseIdentifier":"s:10OpenAPIKit0A3APIO","identifier":"doc:\/\/OpenAPIKit\/documentation\/OpenAPIKit\/OpenAPI"},{"kind":"text","text":"."},{"kind":"typeIdentifier","text":"Components","preciseIdentifier":"s:10OpenAPIKit0A3APIO10ComponentsV","identifier":"doc:\/\/OpenAPIKit\/documentation\/OpenAPIKit\/OpenAPI\/Components"}],"languages":["swift"]}],"kind":"declarations"},{"content":[{"level":2,"text":"Discussion","anchor":"discussion","type":"heading"},{"inlineContent":[{"text":"Storing components here can be in the interest of being explicit about","type":"text"},{"text":" ","type":"text"},{"text":"the fact that the components are always the same (such as an","type":"text"},{"text":" ","type":"text"},{"text":"“Unauthorized” ","type":"text"},{"code":"Response","type":"codeVoice"},{"text":" definition used on all endpoints) or it might","type":"text"},{"text":" ","type":"text"},{"text":"just be practical to put things here and reference them elsewhere to","type":"text"},{"text":" ","type":"text"},{"text":"cut down on the overall size of the document.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"If your document is defined in Swift then this is a less beneficial way to"},{"type":"text","text":" "},{"type":"text","text":"share definitions than to just use the same Swift value multiple times, but"},{"type":"text","text":" "},{"type":"text","text":"you still might want to consider using the Components Object for its impact"},{"type":"text","text":" "},{"type":"text","text":"on the JSON\/YAML structure of your document once encoded."}],"type":"paragraph"}],"kind":"content"}],"sections":[],"kind":"symbol","references":{"doc://OpenAPIKit/documentation/OpenAPIKit/OpenAPI/Document":{"title":"OpenAPI.Document","type":"topic","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Document"}],"role":"symbol","abstract":[{"type":"text","text":"The root of an OpenAPI 3.1 document."}],"kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"Document"}],"identifier":"doc:\/\/OpenAPIKit\/documentation\/OpenAPIKit\/OpenAPI\/Document","url":"\/documentation\/openapikit\/openapi\/document"},"doc://OpenAPIKit/documentation/OpenAPIKit/OpenAPI":{"url":"\/documentation\/openapikit\/openapi","identifier":"doc:\/\/OpenAPIKit\/documentation\/OpenAPIKit\/OpenAPI","abstract":[{"type":"text","text":"The OpenAPI names