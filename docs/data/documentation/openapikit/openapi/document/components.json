{"identifier":{"url":"doc:\/\/OpenAPIKit\/documentation\/OpenAPIKit\/OpenAPI\/Document\/components","interfaceLanguage":"swift"},"abstract":[{"text":"Storage for components that need to be referenced elsewhere in the","type":"text"},{"text":" ","type":"text"},{"text":"OpenAPI Document using ","type":"text"},{"code":"OpenAPI.References","type":"codeVoice"},{"text":".","type":"text"}],"metadata":{"modules":[{"name":"OpenAPIKit"}],"role":"symbol","title":"components","fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"components","kind":"identifier"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:10OpenAPIKit0A3APIO","text":"OpenAPI","kind":"typeIdentifier"},{"text":".","kind":"text"},{"preciseIdentifier":"s:10OpenAPIKit0A3APIO10ComponentsV","text":"Components","kind":"typeIdentifier"}],"externalID":"s:10OpenAPIKit0A3APIO8DocumentV10componentsAC10ComponentsVvp","roleHeading":"Instance Property","symbolKind":"property"},"hierarchy":{"paths":[["doc:\/\/OpenAPIKit\/documentation\/OpenAPIKit","doc:\/\/OpenAPIKit\/documentation\/OpenAPIKit\/OpenAPI","doc:\/\/OpenAPIKit\/documentation\/OpenAPIKit\/OpenAPI\/Document"]]},"schemaVersion":{"minor":3,"patch":0,"major":0},"sections":[],"primaryContentSections":[{"declarations":[{"languages":["swift"],"tokens":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"components","kind":"identifier"},{"text":": ","kind":"text"},{"text":"OpenAPI","identifier":"doc:\/\/OpenAPIKit\/documentation\/OpenAPIKit\/OpenAPI","kind":"typeIdentifier","preciseIdentifier":"s:10OpenAPIKit0A3APIO"},{"text":".","kind":"text"},{"text":"Components","identifier":"doc:\/\/OpenAPIKit\/documentation\/OpenAPIKit\/OpenAPI\/Components","kind":"typeIdentifier","preciseIdentifier":"s:10OpenAPIKit0A3APIO10ComponentsV"}],"platforms":["Linux"]}],"kind":"declarations"},{"content":[{"type":"heading","level":2,"text":"Discussion","anchor":"discussion"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Storing components here can be in the interest of being explicit about"},{"type":"text","text":" "},{"type":"text","text":"the fact that the components are always the same (such as an"},{"type":"text","text":" "},{"type":"text","text":"“Unauthorized” "},{"code":"Response","type":"codeVoice"},{"type":"text","text":" definition used on all endpoints) or it might"},{"type":"text","text":" "},{"type":"text","text":"just be practical to put things here and reference them elsewhere to"},{"type":"text","text":" "},{"type":"text","text":"cut down on the overall size of the document."}]},{"type":"paragraph","inlineContent":[{"text":"If your document is defined in Swift then this is a less beneficial way to","type":"text"},{"text":" ","type":"text"},{"text":"share definitions than to just use the same Swift value multiple times, but","type":"text"},{"text":" ","type":"text"},{"text":"you still might want to consider using the Components Object for its impact","type":"text"},{"text":" ","type":"text"},{"text":"on the JSON\/YAML structure of your document once encoded.","type":"text"}]}],"kind":"content"}],"kind":"symbol","variants":[{"paths":["\/documentation\/openapikit\/openapi\/document\/components"],"traits":[{"interfaceLanguage":"swift"}]}],"references":{"doc://OpenAPIKit/documentation/OpenAPIKit/OpenAPI/Document/components":{"abstract":[{"text":"Storage for components that need to be referenced elsewhere in the","type":"text"},{"text":" ","type":"text"},{"text":"OpenAPI Document using ","type":"text"},{"type":"codeVoice","code":"OpenAPI.References"},{"text":".","type":"text"}],"type":"topic","role":"symbol","kind":"symbol","fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"components","kind":"identifier"},{"text":": ","kind":"text"},{"text":"OpenAPI","kind":"typeIdentifier","preciseIdentifier":"s:10OpenAPIKit0A3APIO"},{"text":".","kind":"text"},{"text":"Components","kind":"typeIdentifier","preciseIdentifier":"s:10OpenAPIKit0A3APIO10ComponentsV"}],"iden