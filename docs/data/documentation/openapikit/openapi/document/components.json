{"schemaVersion":{"minor":3,"major":0,"patch":0},"abstract":[{"text":"Storage for components that need to be referenced elsewhere in the","type":"text"},{"text":" ","type":"text"},{"text":"OpenAPI Document using ","type":"text"},{"code":"OpenAPI.References","type":"codeVoice"},{"text":".","type":"text"}],"sections":[],"metadata":{"title":"components","role":"symbol","fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"components"},{"kind":"text","text":": "},{"preciseIdentifier":"s:10OpenAPIKit0A3APIO","kind":"typeIdentifier","text":"OpenAPI"},{"kind":"text","text":"."},{"preciseIdentifier":"s:10OpenAPIKit0A3APIO10ComponentsV","kind":"typeIdentifier","text":"Components"}],"roleHeading":"Instance Property","externalID":"s:10OpenAPIKit0A3APIO8DocumentV10componentsAC10ComponentsVvp","symbolKind":"property","modules":[{"name":"OpenAPIKit"}]},"kind":"symbol","hierarchy":{"paths":[["doc:\/\/OpenAPIKit\/documentation\/OpenAPIKit","doc:\/\/OpenAPIKit\/documentation\/OpenAPIKit\/OpenAPI","doc:\/\/OpenAPIKit\/documentation\/OpenAPIKit\/OpenAPI\/Document"]]},"primaryContentSections":[{"kind":"declarations","declarations":[{"languages":["swift"],"tokens":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"components","kind":"identifier"},{"text":": ","kind":"text"},{"text":"OpenAPI","preciseIdentifier":"s:10OpenAPIKit0A3APIO","identifier":"doc:\/\/OpenAPIKit\/documentation\/OpenAPIKit\/OpenAPI","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Components","preciseIdentifier":"s:10OpenAPIKit0A3APIO10ComponentsV","identifier":"doc:\/\/OpenAPIKit\/documentation\/OpenAPIKit\/OpenAPI\/Components","kind":"typeIdentifier"}],"platforms":["Linux"]}]},{"content":[{"text":"Discussion","type":"heading","level":2,"anchor":"discussion"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Storing components here can be in the interest of being explicit about"},{"type":"text","text":" "},{"type":"text","text":"the fact that the components are always the same (such as an"},{"type":"text","text":" "},{"type":"text","text":"“Unauthorized” "},{"code":"Response","type":"codeVoice"},{"type":"text","text":" definition used on all endpoints) or it might"},{"type":"text","text":" "},{"type":"text","text":"just be practical to put things here and reference them elsewhere to"},{"type":"text","text":" "},{"type":"text","text":"cut down on the overall size of the document."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"If your document is defined in Swift then this is a less beneficial way to"},{"type":"text","text":" "},{"type":"text","text":"share definitions than to just use the same Swift value multiple times, but"},{"type":"text","text":" "},{"type":"text","text":"you still might want to consider using the Components Object for its impact"},{"type":"text","text":" "},{"type":"text","text":"on the JSON\/YAML structure of your document once encoded."}]}],"kind":"content"}],"variants":[{"paths":["\/documentation\/openapikit\/openapi\/document\/components"],"traits":[{"interfaceLanguage":"swift"}]}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/OpenAPIKit\/documentation\/OpenAPIKit\/OpenAPI\/Document\/components"},"references":{"doc://OpenAPIKit/documentation/OpenAPIKit/OpenAPI/Document":{"kind":"symbol","title":"OpenAPI.Document","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Document","kind":"identifier"}],"abstract":[{"type":"text","text":"The root of an OpenAPI 3.1 document."}],"identifier":"doc:\/\/OpenAPIKit\/documentation\/OpenAPIKit\/OpenAPI\/Document","navigatorTitle":[{"text":"Document","kind":"identifier"}],"type":"topic","url":"\/documentation\/openapikit\/openapi\/document","role":"symbol"},"doc://OpenAPIKit/documentation/OpenAPIKit":{"kind":"symbol","type":"topic","role":"collection","identifier":"doc:\/\/OpenAPIKit\/documentation\/OpenAPIKit","abstract":[],"title":"OpenAPIKit","url":"\/documentation\/open