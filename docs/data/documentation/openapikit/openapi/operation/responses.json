{"hierarchy":{"paths":[["doc:\/\/OpenAPIKit\/documentation\/OpenAPIKit","doc:\/\/OpenAPIKit\/documentation\/OpenAPIKit\/OpenAPI","doc:\/\/OpenAPIKit\/documentation\/OpenAPIKit\/OpenAPI\/Operation"]]},"kind":"symbol","identifier":{"url":"doc:\/\/OpenAPIKit\/documentation\/OpenAPIKit\/OpenAPI\/Operation\/responses","interfaceLanguage":"swift"},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/openapikit\/openapi\/operation\/responses"]}],"schemaVersion":{"minor":3,"patch":0,"major":0},"metadata":{"role":"symbol","fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"responses","kind":"identifier"},{"text":": ","kind":"text"},{"text":"OpenAPI","kind":"typeIdentifier","preciseIdentifier":"s:10OpenAPIKit0A3APIO"},{"text":".","kind":"text"},{"text":"Response","kind":"typeIdentifier","preciseIdentifier":"s:10OpenAPIKit0A3APIO8ResponseV"},{"text":".","kind":"text"},{"text":"Map","kind":"typeIdentifier","preciseIdentifier":"s:10OpenAPIKit0A3APIO8ResponseV3Mapa"}],"symbolKind":"property","modules":[{"name":"OpenAPIKit"}],"externalID":"s:10OpenAPIKit0A3APIO9OperationV9responses0aB4Core17OrderedDictionaryVyAG6SharedO18ResponseStatusCodeVAG6EitherOyAC9ReferenceVy_AC0J0VGASGGvp","roleHeading":"Instance Property","title":"responses"},"abstract":[{"type":"text","text":"The possible responses for this operation, keyed by status code."}],"primaryContentSections":[{"declarations":[{"languages":["swift"],"platforms":["Linux"],"tokens":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"responses","kind":"identifier"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:10OpenAPIKit0A3APIO","text":"OpenAPI","kind":"typeIdentifier","identifier":"doc:\/\/OpenAPIKit\/documentation\/OpenAPIKit\/OpenAPI"},{"text":".","kind":"text"},{"preciseIdentifier":"s:10OpenAPIKit0A3APIO8ResponseV","text":"Response","kind":"typeIdentifier","identifier":"doc:\/\/OpenAPIKit\/documentation\/OpenAPIKit\/OpenAPI\/Response"},{"text":".","kind":"text"},{"preciseIdentifier":"s:10OpenAPIKit0A3APIO8ResponseV3Mapa","text":"Map","kind":"typeIdentifier","identifier":"doc:\/\/OpenAPIKit\/documentation\/OpenAPIKit\/OpenAPI\/Response\/Map"}]}],"kind":"declarations"},{"content":[{"type":"heading","text":"Discussion","anchor":"discussion","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"The status code keys can be integer values, ranges, or even the"},{"type":"text","text":" "},{"code":"default","type":"codeVoice"},{"type":"text","text":" which just refers to the response to expect where no"},{"type":"text","text":" "},{"type":"text","text":"other respones apply."}]},{"type":"paragraph","inlineContent":[{"text":"Because the map is ordered, you can access responses by either","type":"text"},{"text":" ","type":"text"},{"text":"status code or index. Notice that the values of this dictionary are actually","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"Either"},{"text":" an inline ","type":"text"},{"type":"codeVoice","code":"Response"},{"text":" or a reference to a ","type":"text"},{"type":"codeVoice","code":"Response"},{"text":" that is","type":"text"},{"text":" ","type":"text"},{"text":"defined elsewhere.","type":"text"}]},{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"Example:","type":"text"}],"type":"strong"}]},{"type":"codeListing","syntax":null,"code":["let firstResponse: (OpenAPI.Response.StatusCode, Either<OpenAPI.Reference<OpenAPI.Response>, OpenAPI.Response>)","firstResponse = operation.responses[0]!","","\/\/ literally documented as \"200\" status code:","let successResponse: Either<OpenAPI.Reference<OpenAPI.Response>, OpenAPI.Response>","successResponse = operation.responses[status: 200]!","","\/\/ documented as \"2XX\" status code:","let successResponse2: Either<OpenAPI.Reference<OpenAPI.Response>, OpenAPI.Response>","successResponse2 = operation.responses[.range(.success)]!"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"If you want to access the response (assuming it is inlined) you need to grab"},{"type":"text","text":" "},{"type":"text","text":"it out of the "},{"code":"Either","type":"codeVoice"},{"type":"text","text":"."}]},{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Example:"}],"type":"strong"}]},{"type":"codeListing","syntax":null,"code":["let inlinedResponse = successResponse.responseValue"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"You can also look the response up in the "},{"type":"codeVoice","code":"Components"},{"type":"text","text":". For convenience, you"},{"type":"text","text":" "},{"type":"text","text":"can ask to have the "},{"type":"codeVoice","code":"Either"},{"type":"text","text":" looked up and the result will be the "},{"type":"codeVoice","code":"Response"},{"type":"text","text":" "},{"type":"text","text":"regardless of whether the "},{"type":"codeVoice","code":"Response"},{"type":"text","text":" was inlined or found in the "},{"type":"codeVoice","code":"Components"},{"type":"text","text":"."}]},{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Example:"}],"type":"strong"}]},{"type":"codeListing","syntax":null,"code":["let foundResponse: OpenAPI.Response","foundResponse = document.components.lookup(successResponse)!"]}],"kind":"content"}],"sections":[],"references":{"doc://OpenAPIKit/documentation/OpenAPIKit/OpenAPI/Operation":{"type":"topic","url":"\/documentation\/openapikit\/openapi\/operation","abstract":[{"type":"text","text":"OpenAPI Spec “Operation Object”"}],"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Operation"}],"kind":"symbol","role":"symbol","navigatorTitle":[{"kind":"identifier","text":"Operation"}],"identifier":"doc:\/\/OpenAPIKit\/documentation\/OpenAPIKit\/OpenAPI\/Operation","title":"OpenAPI.Operation"},"doc://OpenAPIKit/documentation/OpenAPIKit/OpenAPI":{"url":"\/documentation\/openapikit\/openapi","role":"sy