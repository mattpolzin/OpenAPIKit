{"hierarchy":{"paths":[["doc:\/\/OpenAPIKit\/documentation\/OpenAPIKit","doc:\/\/OpenAPIKit\/documentation\/OpenAPIKit\/OpenAPI","doc:\/\/OpenAPIKit\/documentation\/OpenAPIKit\/OpenAPI\/Operation"]]},"identifier":{"url":"doc:\/\/OpenAPIKit\/documentation\/OpenAPIKit\/OpenAPI\/Operation\/responses","interfaceLanguage":"swift"},"variants":[{"paths":["\/documentation\/openapikit\/openapi\/operation\/responses"],"traits":[{"interfaceLanguage":"swift"}]}],"kind":"symbol","sections":[],"abstract":[{"text":"The possible responses for this operation, keyed by status code.","type":"text"}],"metadata":{"roleHeading":"Instance Property","symbolKind":"property","fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"responses"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"OpenAPI","preciseIdentifier":"s:10OpenAPIKit0A3APIO"},{"kind":"text","text":"."},{"kind":"typeIdentifier","text":"Response","preciseIdentifier":"s:10OpenAPIKit0A3APIO8ResponseV"},{"kind":"text","text":"."},{"kind":"typeIdentifier","text":"Map","preciseIdentifier":"s:10OpenAPIKit0A3APIO8ResponseV3Mapa"}],"externalID":"s:10OpenAPIKit0A3APIO9OperationV9responses0aB4Core17OrderedDictionaryVyAG6SharedO18ResponseStatusCodeVAG6EitherOyAC9ReferenceVy_AC0J0VGASGGvp","title":"responses","modules":[{"name":"OpenAPIKit"}],"role":"symbol"},"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"responses","kind":"identifier"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:10OpenAPIKit0A3APIO","identifier":"doc:\/\/OpenAPIKit\/documentation\/OpenAPIKit\/OpenAPI","text":"OpenAPI","kind":"typeIdentifier"},{"text":".","kind":"text"},{"preciseIdentifier":"s:10OpenAPIKit0A3APIO8ResponseV","identifier":"doc:\/\/OpenAPIKit\/documentation\/OpenAPIKit\/OpenAPI\/Response","text":"Response","kind":"typeIdentifier"},{"text":".","kind":"text"},{"preciseIdentifier":"s:10OpenAPIKit0A3APIO8ResponseV3Mapa","identifier":"doc:\/\/OpenAPIKit\/documentation\/OpenAPIKit\/OpenAPI\/Response\/Map","text":"Map","kind":"typeIdentifier"}],"platforms":["Linux"],"languages":["swift"]}]},{"content":[{"type":"heading","level":2,"anchor":"discussion","text":"Discussion"},{"type":"paragraph","inlineContent":[{"text":"The status code keys can be integer values, ranges, or even the","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"default"},{"text":" which just refers to the response to expect where no","type":"text"},{"text":" ","type":"text"},{"text":"other respones apply.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Because the map is ordered, you can access responses by either"},{"type":"text","text":" "},{"type":"text","text":"status code or index. Notice that the values of this dictionary are actually"},{"type":"text","text":" "},{"type":"codeVoice","code":"Either"},{"type":"text","text":" an inline "},{"type":"codeVoice","code":"Response"},{"type":"text","text":" or a reference to a "},{"type":"codeVoice","code":"Response"},{"type":"text","text":" that is"},{"type":"text","text":" "},{"type":"text","text":"defined elsewhere."}]},{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Example:"}],"type":"strong"}]},{"type":"codeListing","syntax":null,"code":["let firstResponse: (OpenAPI.Response.StatusCode, Either<OpenAPI.Reference<OpenAPI.Response>, OpenAPI.Response>)","firstResponse = operation.responses[0]!","","\/\/ literally documented as \"200\" status code:","let successResponse: Either<OpenAPI.Reference<OpenAPI.Response>, OpenAPI.Response>","successResponse = operation.responses[status: 200]!","","\/\/ documented as \"2XX\" status code:","let successResponse2: Either<OpenAPI.Reference<OpenAPI.Response>, OpenAPI.Response>","successResponse2 = operation.responses[.range(.success)]!"]},{"type":"paragraph","inlineContent":[{"text":"If you want to access the response (assuming it is inlined) you need to grab","type":"text"},{"text":" ","type":"text"},{"text":"it out of the ","type":"text"},{"type":"codeVoice","code":"Either"},{"text":".","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"Example:","type":"text"}]}]},{"type":"codeListing","syntax":null,"code":["let inlinedResponse = successResponse.responseValue"]},{"type":"paragraph","inlineContent":[{"text":"You can also look the response up in the ","type":"text"},{"type":"codeVoice","code":"Components"},{"text":". For convenience, you","type":"text"},{"text":" ","type":"text"},{"text":"can ask to have the ","type":"text"},{"type":"codeVoice","code":"Either"},{"text":" looked up and the result will be the ","type":"text"},{"type":"codeVoice","code":"Response"},{"text":" ","type":"text"},{"text":"regardless of whether the ","type":"text"},{"type":"codeVoice","code":"Response"},{"text":" was inlined or found in the ","type":"text"},{"type":"codeVoice","code":"Components"},{"text":".","type":"text"}]},{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"Example:","type":"text"}],"type":"strong"}]},{"type":"codeListing","syntax":null,"code":["let foundResponse: OpenAPI.Response","foundResponse = document.components.lookup(successResponse)!"]}],"kind":"content"}],"schemaVersion":{"major":0,"minor":3,"patch":0},"references":{"doc://OpenAPIKit/documentation/OpenAPIKit/OpenAPI":{"kind":"symbol","type":"topic","identifier":"doc:\/\/OpenAPIKit\/documentation\/OpenAPIKit\/OpenAPI","fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"OpenAPI"}],"title":"OpenAPI","role":"symbol","url":"\/documentation\/openapikit\/openapi","navigatorTitle":[{"kind":"identifier","text":"OpenAPI"}],"abstract":[{"type":"text","text":"The OpenAPI namespace"}]},"doc://OpenAPIKit/documentation/OpenAPIKit":{"abstract":[],"identifier":"doc:\/\/OpenAPIKit\/documentation\/OpenAPIKit","kind":"symbol","url":"\/documentation\/openapikit","title":"OpenAPIKit","type":"topic","role":"collection"},"doc://OpenAPIKit/documentation/OpenAPIKit/OpenAPI/Response":{"navigatorTitle":[{"kind":"identifier","text":"Response"}],"abstract":[{"text":"OpenAPI Spec “Response Object”","type":"text"}],"identifier":"doc:\/\/OpenAPIKit\/documentation\/OpenAPIKit\/OpenAPI\/Response","kind":"symbol","url":"\/documentation\/openapikit\/openapi\/response","title":"OpenAPI.Response","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Response"}],"type":"topic","role":"symbol"},"doc://OpenAPIKit/documentation/OpenAPIKit/OpenAPI/Operation/responses":{"fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"responses"},{"kind":"text","text":": "},{"preciseIdentifier":"s:10OpenAPIKit0A3APIO","kind":"typeIdentifier","text":"OpenAPI"},{"kind":"text","text":"."},{"preciseIdentifier":"s:10OpenAPIKit0A3APIO8ResponseV","kind":"typeIdentifier","text":"Response"},{"kind":"text","text":"."},{"preciseIdentifier":"s:10OpenAPIKit0A3APIO8ResponseV3Mapa","kind":"typeIdentifier","text":"Map"}],"kind":"symbol","url":"\/documentation\/openapikit\/openapi\/operation\/responses","title":"responses","abstract":[{"text":"The possible responses for this operation, keyed by status code.","type":"text"}],"role":"symbol","type":"topic","identifier":"doc:\/\/OpenAPIKit\/documentation\/OpenAPIKit\/OpenAPI\/Operation\/responses"},"doc://OpenAPIKit/documentation/OpenAPIKit/OpenAPI/Response/Map":{"abstract":[],"title":"OpenAPI.Response.Map","fragments":[{"text":"typealias","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Map","kind":"identifier"}],"url":"\/documentation\/openapikit\/openapi\/response\/map","identifier":"doc:\/\/OpenAPIKit\/documentation\/OpenAPIKit\/OpenAPI\/Response\/Map","kind":"symbol","navigatorTitle":[{"text":"Map","kind":"identifier"}],"role":"symbol","type":"topic"},"doc://OpenAPIKit/documentation/OpenAPIKit/OpenAPI/Operation":{"ide