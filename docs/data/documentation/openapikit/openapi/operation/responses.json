s":["swift"]}],"kind":"declarations"},{"content":[{"type":"heading","text":"Discussion","level":2,"anchor":"discussion"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The status code keys can be integer values, ranges, or even the"},{"type":"text","text":" "},{"type":"codeVoice","code":"default"},{"type":"text","text":" which just refers to the response to expect where no"},{"type":"text","text":" "},{"type":"text","text":"other respones apply."}]},{"type":"paragraph","inlineContent":[{"text":"Because the map is ordered, you can access responses by either","type":"text"},{"text":" ","type":"text"},{"text":"status code or index. Notice that the values of this dictionary are actually","type":"text"},{"text":" ","type":"text"},{"code":"Either","type":"codeVoice"},{"text":" an inline ","type":"text"},{"code":"Response","type":"codeVoice"},{"text":" or a reference to a ","type":"text"},{"code":"Response","type":"codeVoice"},{"text":" that is","type":"text"},{"text":" ","type":"text"},{"text":"defined elsewhere.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"Example:","type":"text"}]}]},{"type":"codeListing","syntax":null,"code":["let firstResponse: (OpenAPI.Response.StatusCode, Either<OpenAPI.Reference<OpenAPI.Response>, OpenAPI.Response>)","firstResponse = operation.responses[0]!","","\/\/ literally documented as \"200\" status code:","let successResponse: Either<OpenAPI.Reference<OpenAPI.Response>, OpenAPI.Response>","successResponse = operation.responses[status: 200]!","","\/\/ documented as \"2XX\" status code:","let successResponse2: Either<OpenAPI.Reference<OpenAPI.Response>, OpenAPI.Response>","successResponse2 = operation.responses[.range(.success)]!"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"If you want to access the response (assuming it is inlined) you need to grab"},{"type":"text","text":" "},{"type":"text","text":"it out of the "},{"type":"codeVoice","code":"Either"},{"type":"text","text":"."}]},{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"Example:","type":"text"}]}]},{"type":"codeListing","syntax":null,"code":["let inlinedResponse = successResponse.responseValue"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"You can also look the response up in the "},{"type":"codeVoice","code":"Components"},{"type":"text","text":". For convenience, you"},{"type":"text","text":" "},{"type":"text","text":"can ask to have the "},{"type":"codeVoice","code":"Either"},{"type":"text","text":" looked up and the result will be the "},{"type":"codeVoice","code":"Response"},{"type":"text","text":" "},{"type":"text","text":"regardless of whether the "},{"type":"codeVoice","code":"Response"},{"type":"text","text":" was inlined or found in the "},{"type":"codeVoice","code":"Components"},{"type":"text","text":"."}]},{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"Example:","type":"text"}]}]},{"type":"codeListing","syntax":null,"code":["let foundResponse: OpenAPI.Response","foundResponse = document.components.lookup(successResponse)!"]}],"kind":"content"}],"hierarchy":{"paths":[["doc:\/\/OpenAPIKit\/documentation\/OpenAPIKit","doc:\/\/OpenAPIKit\/documentation\/OpenAPIKit\/OpenAPI","doc:\/\/OpenAPIKit\/documentation\/OpenAPIKit\/OpenAPI\/Operation"]]},"references":{"doc://OpenAPIKit/documentation/OpenAPIKit/OpenAPI/Operation/responses":{"role":"symbol","identifier":"doc:\/\/OpenAPIKit\/documentation\/OpenAPIKit\/OpenAPI\/Operation\/responses","url":"\/documentation\/openapikit\/openapi\/operation\/responses","kind":"symbol","abstract":[{"text":"The possible responses for this operation, keyed by status code.","type":"text"}],"type":"topic","title":"responses","fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"responses","kind":"identifier"},{"text":": ","kind":"text"},{"text":"OpenAPI","preciseIdentifier":"s:10OpenAPIKit0A3APIO","kind":"typeIdentifier"},{