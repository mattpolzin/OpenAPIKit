{"sections":[],"primaryContentSections":[{"declarations":[{"languages":["swift"],"tokens":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"responses"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"OpenAPI","preciseIdentifier":"s:10OpenAPIKit0A3APIO","identifier":"doc:\/\/OpenAPIKit\/documentation\/OpenAPIKit\/OpenAPI"},{"kind":"text","text":"."},{"kind":"typeIdentifier","text":"Response","preciseIdentifier":"s:10OpenAPIKit0A3APIO8ResponseV","identifier":"doc:\/\/OpenAPIKit\/documentation\/OpenAPIKit\/OpenAPI\/Response"},{"kind":"text","text":"."},{"kind":"typeIdentifier","text":"Map","preciseIdentifier":"s:10OpenAPIKit0A3APIO8ResponseV3Mapa","identifier":"doc:\/\/OpenAPIKit\/documentation\/OpenAPIKit\/OpenAPI\/Response\/Map"}],"platforms":["Linux"]}],"kind":"declarations"},{"content":[{"anchor":"discussion","type":"heading","level":2,"text":"Discussion"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The status code keys can be integer values, ranges, or even the"},{"type":"text","text":" "},{"type":"codeVoice","code":"default"},{"type":"text","text":" which just refers to the response to expect where no"},{"type":"text","text":" "},{"type":"text","text":"other respones apply."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Because the map is ordered, you can access responses by either"},{"type":"text","text":" "},{"type":"text","text":"status code or index. Notice that the values of this dictionary are actually"},{"type":"text","text":" "},{"type":"codeVoice","code":"Either"},{"type":"text","text":" an inline "},{"type":"codeVoice","code":"Response"},{"type":"text","text":" or a reference to a "},{"type":"codeVoice","code":"Response"},{"type":"text","text":" that is"},{"type":"text","text":" "},{"type":"text","text":"defined elsewhere."}]},{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"Example:","type":"text"}],"type":"strong"}]},{"code":["let firstResponse: (OpenAPI.Response.StatusCode, Either<OpenAPI.Reference<OpenAPI.Response>, OpenAPI.Response>)","firstResponse = operation.responses[0]!","","\/\/ literally documented as \"200\" status code:","let successResponse: Either<OpenAPI.Reference<OpenAPI.Response>, OpenAPI.Response>","successResponse = operation.responses[status: 200]!","","\/\/ documented as \"2XX\" status code:","let successResponse2: Either<OpenAPI.Reference<OpenAPI.Response>, OpenAPI.Response>","successResponse2 = operation.responses[.range(.success)]!"],"type":"codeListing","syntax":null},{"type":"paragraph","inlineContent":[{"text":"If you want to access the response (assuming it is inlined) you need to grab","type":"text"},{"text":" ","type":"text"},{"text":"it out of the ","type":"text"},{"code":"Either","type":"codeVoice"},{"text":".","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Example:"}]}]},{"code":["let inlinedResponse = successResponse.responseValue"],"type":"codeListing","syntax":null},{"type":"paragraph","inlineContent":[{"text":"You can also look the response up in the ","type":"text"},{"type":"codeVoice","code":"Components"},{"text":". For convenience, you","type":"text"},{"text":" ","type":"text"},{"text":"can ask to have the ","type":"text"},{"type":"codeVoice","code":"Either"},{"text":" looked up and the result will be the ","type":"text"},{"type":"codeVoice","code":"Response"},{"text":" ","type":"text"},{"text":"regardless of whether the ","type":"text"},{"type":"codeVoice","code":"Response"},{"text":" was inlined or found in the ","type":"text"},{"type":"codeVoice","code":"Components"},{"text":".","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Example:"}]}]},{"code":["let foundResponse: OpenAPI.Response","foundResponse = document.components.lookup(successResponse)!"],"type":"codeListing","syntax":null}],"kind":"content"}],"kind":"symbol","metadata":{"title":"respon