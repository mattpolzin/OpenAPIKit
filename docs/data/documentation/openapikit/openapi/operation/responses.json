on","anchor":"discussion","type":"heading"},{"type":"paragraph","inlineContent":[{"text":"The status code keys can be integer values, ranges, or even the","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"default"},{"text":" which just refers to the response to expect where no","type":"text"},{"text":" ","type":"text"},{"text":"other respones apply.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Because the map is ordered, you can access responses by either"},{"type":"text","text":" "},{"type":"text","text":"status code or index. Notice that the values of this dictionary are actually"},{"type":"text","text":" "},{"type":"codeVoice","code":"Either"},{"type":"text","text":" an inline "},{"type":"codeVoice","code":"Response"},{"type":"text","text":" or a reference to a "},{"type":"codeVoice","code":"Response"},{"type":"text","text":" that is"},{"type":"text","text":" "},{"type":"text","text":"defined elsewhere."}]},{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"Example:","type":"text"}]}]},{"syntax":null,"type":"codeListing","code":["let firstResponse: (OpenAPI.Response.StatusCode, Either<OpenAPI.Reference<OpenAPI.Response>, OpenAPI.Response>)","firstResponse = operation.responses[0]!","","\/\/ literally documented as \"200\" status code:","let successResponse: Either<OpenAPI.Reference<OpenAPI.Response>, OpenAPI.Response>","successResponse = operation.responses[status: 200]!","","\/\/ documented as \"2XX\" status code:","let successResponse2: Either<OpenAPI.Reference<OpenAPI.Response>, OpenAPI.Response>","successResponse2 = operation.responses[.range(.success)]!"]},{"type":"paragraph","inlineContent":[{"text":"If you want to access the response (assuming it is inlined) you need to grab","type":"text"},{"text":" ","type":"text"},{"text":"it out of the ","type":"text"},{"type":"codeVoice","code":"Either"},{"text":".","type":"text"}]},{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"Example:","type":"text"}],"type":"strong"}]},{"syntax":null,"type":"codeListing","code":["let inlinedResponse = successResponse.responseValue"]},{"type":"paragraph","inlineContent":[{"text":"You can also look the response up in the ","type":"text"},{"code":"Components","type":"codeVoice"},{"text":". For convenience, you","type":"text"},{"text":" ","type":"text"},{"text":"can ask to have the ","type":"text"},{"code":"Either","type":"codeVoice"},{"text":" looked up and the result will be the ","type":"text"},{"code":"Response","type":"codeVoice"},{"text":" ","type":"text"},{"text":"regardless of whether the ","type":"text"},{"code":"Response","type":"codeVoice"},{"text":" was inlined or found in the ","type":"text"},{"code":"Components","type":"codeVoice"},{"text":".","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Example:"}]}]},{"syntax":null,"type":"codeListing","code":["let foundResponse: OpenAPI.Response","foundResponse = document.components.lookup(successResponse)!"]}]}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/OpenAPIKit\/documentation\/OpenAPIKit\/OpenAPI\/Operation\/responses"},"abstract":[{"type":"text","text":"The possible responses for this operation, keyed by status code."}],"sections":[],"schemaVersion":{"minor":3,"major":0,"patch":0},"references":{"doc://OpenAPIKit/documentation/OpenAPIKit/OpenAPI/Response/Map":{"abstract":[],"kind":"symbol","fragments":[{"text":"typealias","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Map","kind":"identifier"}],"identifier":"doc:\/\/OpenAPIKit\/documentation\/OpenAPIKit\/OpenAPI\/Response\/Map","navigatorTitle":[{"text":"Map","kind":"identifier"}],"url":"\/documentation\/openapikit\/openapi\/response\/map","type":"topic","role":"symbol","title":"OpenAPI.Response.Map"},"doc://OpenAPIKit/documentation/OpenAPIKit/OpenAPI/Response":{"kind":"symbol","title":"OpenAPI.Response","fragments":[{"kind":"keyword","text":"struct"},{"kind