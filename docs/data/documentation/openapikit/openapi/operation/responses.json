{"hierarchy":{"paths":[["doc:\/\/OpenAPIKit\/documentation\/OpenAPIKit","doc:\/\/OpenAPIKit\/documentation\/OpenAPIKit\/OpenAPI","doc:\/\/OpenAPIKit\/documentation\/OpenAPIKit\/OpenAPI\/Operation"]]},"metadata":{"role":"symbol","fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"responses","kind":"identifier"},{"text":": ","kind":"text"},{"text":"OpenAPI","kind":"typeIdentifier","preciseIdentifier":"s:10OpenAPIKit0A3APIO"},{"text":".","kind":"text"},{"text":"Response","kind":"typeIdentifier","preciseIdentifier":"s:10OpenAPIKit0A3APIO8ResponseV"},{"text":".","kind":"text"},{"text":"Map","kind":"typeIdentifier","preciseIdentifier":"s:10OpenAPIKit0A3APIO8ResponseV3Mapa"}],"modules":[{"name":"OpenAPIKit"}],"symbolKind":"property","title":"responses","externalID":"s:10OpenAPIKit0A3APIO9OperationV9responses0aB4Core17OrderedDictionaryVyAG6SharedO18ResponseStatusCodeVAG6EitherOyAC9ReferenceVy_AC0J0VGASGGvp","roleHeading":"Instance Property"},"sections":[],"schemaVersion":{"patch":0,"minor":3,"major":0},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/OpenAPIKit\/documentation\/OpenAPIKit\/OpenAPI\/Operation\/responses"},"kind":"symbol","abstract":[{"text":"The possible responses for this operation, keyed by status code.","type":"text"}],"variants":[{"paths":["\/documentation\/openapikit\/openapi\/operation\/responses"],"traits":[{"interfaceLanguage":"swift"}]}],"primaryContentSections":[{"declarations":[{"platforms":["Linux"],"tokens":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"responses"},{"kind":"text","text":": "},{"preciseIdentifier":"s:10OpenAPIKit0A3APIO","kind":"typeIdentifier","text":"OpenAPI","identifier":"doc:\/\/OpenAPIKit\/documentation\/OpenAPIKit\/OpenAPI"},{"kind":"text","text":"."},{"preciseIdentifier":"s:10OpenAPIKit0A3APIO8ResponseV","kind":"typeIdentifier","text":"Response","identifier":"doc:\/\/OpenAPIKit\/documentation\/OpenAPIKit\/OpenAPI\/Response"},{"kind":"text","text":"."},{"preciseIdentifier":"s:10OpenAPIKit0A3APIO8ResponseV3Mapa","kind":"typeIdentifier","text":"Map","identifier":"doc:\/\/OpenAPIKit\/documentation\/OpenAPIKit\/OpenAPI\/Response\/Map"}],"languages":["swift"]}],"kind":"declarations"},{"kind":"content","content":[{"anchor":"discussion","level":2,"text":"Discussion","type":"heading"},{"inlineContent":[{"type":"text","text":"The status code keys can be integer values, ranges, or even the"},{"type":"text","text":" "},{"type":"codeVoice","code":"default"},{"type":"text","text":" which just refers to the response to expect where no"},{"type":"text","text":" "},{"type":"text","text":"other respones apply."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Because the map is ordered, you can access responses by either"},{"type":"text","text":" "},{"type":"text","text":"status code or index. Notice that the values of this dictionary are actually"},{"type":"text","text":" "},{"type":"codeVoice","code":"Either"},{"type":"text","text":" an inline "},{"type":"codeVoice","code":"Response"},{"type":"text","text":" or a reference to a "},{"type":"codeVoice","code":"Response"},{"type":"text","text":" that is"},{"type":"text","text":" "},{"type":"text","text":"defined elsewhere."}],"type":"paragraph"},{"inlineContent":[{"type":"strong","inlineContent":[{"text":"Example:","type":"text"}]}],"type":"paragraph"},{"code":["let firstResponse: (OpenAPI.Response.StatusCode, Either<OpenAPI.Reference<OpenAPI.Response>, OpenAPI.Response>)","firstResponse = operation.responses[0]!","","\/\/ literally documented as \"200\" status code:","let successResponse: Either<OpenAPI.Reference<OpenAPI.Response>, OpenAPI.Response>","successResponse = operation.responses[status: 200]!","","\/\/ documented as \"2XX\" status code:","let successResponse2: Either<OpenAPI.Reference<OpenAPI.Response>, OpenAPI.Response>","successResponse2 = operation.responses[.range(.success)]!"],"syntax":null,"type":"codeListing"},{"inlineContent":[{"type":"text","text":"If you want to access the response (assuming it is inlined) you need to grab"},{"type":"text","text":" "},{"type":"text","text":"it out of the "},{"type":"codeVoice","code":"Either"},{"type":"text","text":"."}],"type":"paragraph"},{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Example:"}]}],"type":"paragraph"},{"code":["let inlinedResponse = successResponse.responseValue"],"syntax":null,"type":"codeListing"},{"inlineContent":[{"type":"text","text":"You can also look the response up in the "},{"type":"codeVoice","code":"Components"},{"type":"text","text":". For convenience, you"},{"type":"text","text":" "},{"type":"text","text":"can ask to have the "},{"type":"codeVoice","code":"Either"},{"type":"text","text":" looked up and the result will be the "},{"type":"codeVoice","code":"Response"},{"type":"text","text":" "},{"type":"text","text":"regardless of whether the "},{"type":"codeVoice","code":"Response"},{"type":"text","text":" was inlined or found in the "},{"type":"codeVoice","code":"Components"},{"type":"text","text":"."}],"type":"paragraph"},{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Example:"}]}],"type":"paragraph"},{"code":["let foundResponse: OpenAPI.Response","foundResponse = document.components.lookup(successResponse)!"],"syntax":null,"type":"codeListing"}]}],"references":{"doc://OpenAPIKit/documentation/OpenAPIKit/OpenAPI/Operation":{"kind":"symbol","title":"OpenAPI.Operation","identifier":"doc:\/\/OpenAPIKit\/documentation\/OpenAPIKit\/OpenAPI\/Operation","type":"topic","abstract":[{"text":"OpenAPI Spec “Operation Object”","type":"text"}],"role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Operation"}],"navigatorTitle":[{"kind":"identifier","text":"Operation"}],"url":"\/documentation\/openapikit\/openapi\/operation"},"doc://OpenAPIKit/documentation/OpenAPIKit/OpenAPI/Response":{"title":"OpenAPI.Response","type":"topic","fra