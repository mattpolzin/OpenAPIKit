,{"text":".","kind":"text"},{"preciseIdentifier":"s:10OpenAPIKit0A3APIO8ResponseV3Mapa","text":"Map","kind":"typeIdentifier","identifier":"doc:\/\/OpenAPIKit\/documentation\/OpenAPIKit\/OpenAPI\/Response\/Map"}],"languages":["swift"]}]},{"kind":"content","content":[{"type":"heading","level":2,"text":"Discussion","anchor":"discussion"},{"type":"paragraph","inlineContent":[{"text":"The status code keys can be integer values, ranges, or even the","type":"text"},{"text":" ","type":"text"},{"code":"default","type":"codeVoice"},{"text":" which just refers to the response to expect where no","type":"text"},{"text":" ","type":"text"},{"text":"other respones apply.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"Because the map is ordered, you can access responses by either","type":"text"},{"text":" ","type":"text"},{"text":"status code or index. Notice that the values of this dictionary are actually","type":"text"},{"text":" ","type":"text"},{"code":"Either","type":"codeVoice"},{"text":" an inline ","type":"text"},{"code":"Response","type":"codeVoice"},{"text":" or a reference to a ","type":"text"},{"code":"Response","type":"codeVoice"},{"text":" that is","type":"text"},{"text":" ","type":"text"},{"text":"defined elsewhere.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"Example:","type":"text"}]}]},{"syntax":null,"type":"codeListing","code":["let firstResponse: (OpenAPI.Response.StatusCode, Either<OpenAPI.Reference<OpenAPI.Response>, OpenAPI.Response>)","firstResponse = operation.responses[0]!","","\/\/ literally documented as \"200\" status code:","let successResponse: Either<OpenAPI.Reference<OpenAPI.Response>, OpenAPI.Response>","successResponse = operation.responses[status: 200]!","","\/\/ documented as \"2XX\" status code:","let successResponse2: Either<OpenAPI.Reference<OpenAPI.Response>, OpenAPI.Response>","successResponse2 = operation.responses[.range(.success)]!"]},{"type":"paragraph","inlineContent":[{"text":"If you want to access the response (assuming it is inlined) you need to grab","type":"text"},{"text":" ","type":"text"},{"text":"it out of the ","type":"text"},{"code":"Either","type":"codeVoice"},{"text":".","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Example:"}]}]},{"syntax":null,"type":"codeListing","code":["let inlinedResponse = successResponse.responseValue"]},{"type":"paragraph","inlineContent":[{"text":"You can also look the response up in the ","type":"text"},{"type":"codeVoice","code":"Components"},{"text":". For convenience, you","type":"text"},{"text":" ","type":"text"},{"text":"can ask to have the ","type":"text"},{"type":"codeVoice","code":"Either"},{"text":" looked up and the result will be the ","type":"text"},{"type":"codeVoice","code":"Response"},{"text":" ","type":"text"},{"text":"regardless of whether the ","type":"text"},{"type":"codeVoice","code":"Response"},{"text":" was inlined or found in the ","type":"text"},{"type":"codeVoice","code":"Components"},{"text":".","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"Example:","type":"text"}]}]},{"syntax":null,"type":"codeListing","code":["let foundResponse: OpenAPI.Response","foundResponse = document.components.lookup(successResponse)!"]}]}],"references":{"doc://OpenAPIKit/documentation/OpenAPIKit/OpenAPI/Response":{"url":"\/documentation\/openapikit\/openapi\/response","abstract":[{"type":"text","text":"OpenAPI Spec “Response Object”"}],"role":"symbol","navigatorTitle":[{"text":"Response","kind":"identifier"}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Response","kind":"identifier"}],"type":"topic","title":"OpenAPI.Response","kind":"symbol","identifier":"doc:\/\/OpenAPIKit\/documentation\/OpenAPIKit\/OpenAPI\/Response"},"doc://OpenAPIKit/documentation/OpenAPIKit":{"identifier":"doc:\/\/OpenAPIKit\/documentation\/OpenAPIKit","title":"