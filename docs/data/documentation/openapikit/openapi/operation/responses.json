{"abstract":[{"text":"The possible responses for this operation, keyed by status code.","type":"text"}],"primaryContentSections":[{"kind":"declarations","declarations":[{"languages":["swift"],"platforms":["Linux"],"tokens":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"responses","kind":"identifier"},{"text":": ","kind":"text"},{"identifier":"doc:\/\/OpenAPIKit\/documentation\/OpenAPIKit\/OpenAPI","text":"OpenAPI","preciseIdentifier":"s:10OpenAPIKit0A3APIO","kind":"typeIdentifier"},{"text":".","kind":"text"},{"identifier":"doc:\/\/OpenAPIKit\/documentation\/OpenAPIKit\/OpenAPI\/Response","text":"Response","preciseIdentifier":"s:10OpenAPIKit0A3APIO8ResponseV","kind":"typeIdentifier"},{"text":".","kind":"text"},{"identifier":"doc:\/\/OpenAPIKit\/documentation\/OpenAPIKit\/OpenAPI\/Response\/Map","text":"Map","preciseIdentifier":"s:10OpenAPIKit0A3APIO8ResponseV3Mapa","kind":"typeIdentifier"}]}]},{"kind":"content","content":[{"text":"Discussion","level":2,"type":"heading","anchor":"discussion"},{"inlineContent":[{"type":"text","text":"The status code keys can be integer values, ranges, or even the"},{"type":"text","text":" "},{"type":"codeVoice","code":"default"},{"type":"text","text":" which just refers to the response to expect where no"},{"type":"text","text":" "},{"type":"text","text":"other respones apply."}],"type":"paragraph"},{"inlineContent":[{"text":"Because the map is ordered, you can access responses by either","type":"text"},{"text":" ","type":"text"},{"text":"status code or index. Notice that the values of this dictionary are actually","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"Either"},{"text":" an inline ","type":"text"},{"type":"codeVoice","code":"Response"},{"text":" or a reference to a ","type":"text"},{"type":"codeVoice","code":"Response"},{"text":" that is","type":"text"},{"text":" ","type":"text"},{"text":"defined elsewhere.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"strong","inl