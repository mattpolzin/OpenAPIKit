"kind":"text","text":" }"}],"platforms":["Linux"],"languages":["swift"]}],"kind":"declarations"},{"content":[{"anchor":"discussion","type":"heading","text":"Discussion","level":2},{"inlineContent":[{"text":"The JSON Schema Specification does not require that components","type":"text"},{"text":" ","type":"text"},{"text":"have any defining characteristics. An “empty” schema component can","type":"text"},{"text":" ","type":"text"},{"text":"be written as follows:","type":"text"}],"type":"paragraph"},{"syntax":null,"code":["{","}"],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"It is reasonable, however, to want to validate that all schema components"},{"type":"text","text":" "},{"type":"text","text":"are non-empty and therefore offer some value to the consumer\/reader of"},{"type":"text","text":" "},{"type":"text","text":"the OpenAPI documentation beyond just “this property exists.”"}],"type":"paragraph"},{"type":"aside","style":"note","name":"Note","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"A sneaky way for the empty object to get into documentation is"},{"type":"text","text":" "},{"type":"text","text":"by putting a property name in a parent object’s "},{"code":"required","type":"codeVoice"},{"type":"text","text":" array"},{"type":"text","text":" "},{"type":"text","text":"without adding that property to the "},{"code":"properties","type":"codeVoice"},{"type":"text","text":" map."}]}]},{"type":"aside","style":"important","name":"Important","content":[{"inlineContent":[{"text":"This is not an included validation by default.","type":"text"}],"type":"paragraph"}]}],"kind":"content"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/openapikit\/builtinvalidation\/schemacomponentsaredefined"]}],"kind":"symbol","references":{"doc://OpenAPIKit/documentation/OpenAPIKit/Validation":{"abstract":[{"type":"text","text":"Holds a function to determine if a validation"},{"type":"text","text":" "},{"type":"text