sion","type":"heading"},{"inlineContent":[{"text":"The JSON Schema Specification does not require that components","type":"text"},{"text":" ","type":"text"},{"text":"have any defining characteristics. An “empty” schema component can","type":"text"},{"text":" ","type":"text"},{"text":"be written as follows:","type":"text"}],"type":"paragraph"},{"code":["{","}"],"syntax":null,"type":"codeListing"},{"inlineContent":[{"text":"It is reasonable, however, to want to validate that all schema components","type":"text"},{"text":" ","type":"text"},{"text":"are non-empty and therefore offer some value to the consumer\/reader of","type":"text"},{"text":" ","type":"text"},{"text":"the OpenAPI documentation beyond just “this property exists.”","type":"text"}],"type":"paragraph"},{"style":"note","content":[{"type":"paragraph","inlineContent":[{"text":"A sneaky way for the empty object to get into documentation is","type":"text"},{"text":" ","type":"text"},{"text":"by putting a property name in a parent object’s ","type":"text"},{"type":"codeVoice","code":"required"},{"text":" array","type":"text"},{"text":" ","type":"text"},{"text":"without adding that property to the ","type":"text"},{"type":"codeVoice","code":"properties"},{"text":" map.","type":"text"}]}],"name":"Note","type":"aside"},{"style":"important","content":[{"inlineContent":[{"type":"text","text":"This is not an included validation by default."}],"type":"paragraph"}],"name":"Important","type":"aside"}]}],"hierarchy":{"paths":[["doc:\/\/OpenAPIKit\/documentation\/OpenAPIKit","doc:\/\/OpenAPIKit\/documentation\/OpenAPIKit\/BuiltinValidation"]]},"schemaVersion":{"major":0,"minor":3,"patch":0},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/openapikit\/builtinvalidation\/schemacomponentsaredefined"]}],"references":{"doc://OpenAPIKit/documentation/OpenAPIKit/Validation":{"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Validation"}],"kind