 }","kind":"text"}],"platforms":["Linux"],"languages":["swift"]}]},{"kind":"content","content":[{"level":2,"type":"heading","anchor":"discussion","text":"Discussion"},{"inlineContent":[{"type":"text","text":"The JSON Schema Specification does not require that components"},{"type":"text","text":" "},{"type":"text","text":"have any defining characteristics. An “empty” schema component can"},{"type":"text","text":" "},{"type":"text","text":"be written as follows:"}],"type":"paragraph"},{"code":["{","}"],"type":"codeListing","syntax":null},{"inlineContent":[{"type":"text","text":"It is reasonable, however, to want to validate that all schema components"},{"type":"text","text":" "},{"type":"text","text":"are non-empty and therefore offer some value to the consumer\/reader of"},{"type":"text","text":" "},{"type":"text","text":"the OpenAPI documentation beyond just “this property exists.”"}],"type":"paragraph"},{"style":"note","type":"aside","name":"Note","content":[{"inlineContent":[{"type":"text","text":"A sneaky way for the empty object to get into documentation is"},{"type":"text","text":" "},{"type":"text","text":"by putting a property name in a parent object’s "},{"type":"codeVoice","code":"required"},{"type":"text","text":" array"},{"type":"text","text":" "},{"type":"text","text":"without adding that property to the "},{"type":"codeVoice","code":"properties"},{"type":"text","text":" map."}],"type":"paragraph"}]},{"style":"important","type":"aside","name":"Important","content":[{"inlineContent":[{"type":"text","text":"This is not an included validation by default."}],"type":"paragraph"}]}]}],"schemaVersion":{"minor":3,"major":0,"patch":0},"hierarchy":{"paths":[["doc:\/\/OpenAPIKit\/documentation\/OpenAPIKit","doc:\/\/OpenAPIKit\/documentation\/OpenAPIKit\/BuiltinValidation"]]},"references":{"doc://OpenAPIKit/documentation/OpenAPIKit/BuiltinValidation/schemaComponentsAreDefined":{"identifier":"doc:\/\/OpenAPIKit\/documentation\/OpenAPIKit\/BuiltinValidation\/schemaCom