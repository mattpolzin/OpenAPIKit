{"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"DocumentConfiguration"}],"platforms":["Linux"],"languages":["swift"]}]},{"content":[{"anchor":"overview","type":"heading","level":2,"text":"Overview"},{"inlineContent":[{"type":"text","text":"To instruct OpenAPIKit to decode OpenAPI Standards versions it does not"},{"type":"text","text":" "},{"type":"text","text":"natively support, set "},{"code":"userInfo[DocumentConfiguration.versionMapKey] = [\"3.5.0\": OpenAPI.Document.Version.v3_1_1]","type":"codeVoice"},{"type":"text","text":"."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"That will cause OpenAPIKit to accept OAS v3.5.0 on decode and treat it as"},{"type":"text","text":" "},{"type":"text","text":"the natively supported v3.1.1. This feature exists to allow OpenAPIKit to"},{"type":"text","text":" "},{"type":"text","text":"be configured to parse future versions of the OAS standard that are"},{"type":"text","text":" "},{"type":"text","text":"determined (by you) to be backwards compatible with a previous version"},{"type":"text","text":" "},{"type":"text","text":"prior to OpenAPIKit gaining official support for the new version and its"},{"type":"text","text":" "},{"type":"text","text":"features."}],"type":"paragraph"}],"kind":"content"}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/OpenAPIKit\/documentation\/OpenAPIKit\/DocumentConfiguration"},"kind":"symbol","hierarchy":{"paths":[["doc:\/\/OpenAPIKit\/documentation\/OpenAPIKit"]]},"sections":[],"schemaVersion":{"patch":0,"major":0,"minor":3},"metadata":{"roleHeading":"Enumeration","symbolKind":"enum","title":"DocumentConfiguration","fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"DocumentConfiguration","kind":"identifier"}],"navigatorTitle":[{"text":"DocumentConfiguration","kind":"identifier"}],"modules":[{"name":"OpenAPIKit"}],"externalID