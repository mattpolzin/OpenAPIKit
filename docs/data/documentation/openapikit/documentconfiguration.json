{"kind":"symbol","abstract":[{"type":"text","text":"OpenAPIKit supports some additional Encoder\/Decoder configuration above and beyond"},{"type":"text","text":" "},{"type":"text","text":"what the Encoder or Decoder support out of box."}],"schemaVersion":{"minor":3,"patch":0,"major":0},"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"DocumentConfiguration","kind":"identifier"}],"languages":["swift"],"platforms":["Linux"]}]},{"content":[{"level":2,"text":"Overview","anchor":"overview","type":"heading"},{"inlineContent":[{"text":"To instruct OpenAPIKit to decode OpenAPI Standards versions it does not","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"natively support, set "},{"type":"codeVoice","code":"userInfo[DocumentConfiguration.versionMapKey] = [\"3.5.0\": OpenAPI.Document.Version.v3_1_1]"},{"type":"text","text":"."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"That will cause OpenAPIKit to accept OAS v3.5.0 on decode and treat it as"},{"type":"text","text":" "},{"type":"text","text":"the natively supported v3.1.1. This feature exists to allow OpenAPIKit to"},{"type":"text","text":" "},{"type":"text","text":"be configured to parse future versions of the OAS standard that are"},{"type":"text","text":" "},{"type":"text","text":"determined (by you) to be backwards compatible with a previous version"},{"type":"text","text":" "},{"type":"text","text":"prior to OpenAPIKit gaining official support for the new version and its"},{"type":"text","text":" "},{"type":"text","text":"features."}],"type":"paragraph"}],"kind":"content"}],"hierarchy":{"paths":[["doc:\/\/OpenAPIKit\/documentation\/OpenAPIKit"]]},"metadata":{"externalID":"s:10OpenAPIKit21DocumentConfigurationO","roleHeading":"Enumeration","role":"symbol","symbolKind":"enum","modules":[{"name":"OpenAPIKit"}],"navigatorTitle":[{"text":"DocumentConfiguration","kind":"identifier"}],"fragments":