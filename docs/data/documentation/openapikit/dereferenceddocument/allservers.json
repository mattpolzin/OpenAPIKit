"},{"text":" ","type":"text"},{"text":"and therefore may or may not contain servers not found in the","type":"text"},{"text":" ","type":"text"},{"text":"root servers array.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The "},{"type":"codeVoice","code":"servers"},{"type":"text","text":" property on "},{"type":"codeVoice","code":"OpenAPI.Document"},{"type":"text","text":", by contrast, contains"},{"type":"text","text":" "},{"type":"text","text":"servers that are applicable to all paths and operations that"},{"type":"text","text":" "},{"type":"text","text":"do not define their own "},{"type":"codeVoice","code":"serves"},{"type":"text","text":" array to override the root array."}]},{"type":"aside","name":"Important","style":"important","content":[{"inlineContent":[{"type":"text","text":"For the purposes of returning one of each "},{"type":"codeVoice","code":"Server"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"text","text":"two servers are considered identical if they have the same "},{"type":"codeVoice","code":"url"},{"type":"text","text":" "},{"type":"text","text":"and "},{"type":"codeVoice","code":"variables"},{"type":"text","text":". Differing "},{"type":"codeVoice","code":"description"},{"type":"text","text":" properties for"},{"type":"text","text":" "},{"type":"text","text":"otherwise identical servers are considered to be two ways to"},{"type":"text","text":" "},{"type":"text","text":"describe the same server. "},{"type":"codeVoice","code":"vendorExtensions"},{"type":"text","text":" are also"},{"type":"text","text":" "},{"type":"text","text":"ignored when determining server uniqueness."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"The first "},{"code":"Server","type":"codeVoice"},{"type":"text","text":" encountered will be used, so if the only"},{"type":"text","text":" "},{"type":"text","text":"difference between a server at the root document level and"},{"type":"text","text":" "},{"type":"text","text":"one in an "},{"code":"Operation","type":"codeVoice"},{"type":"text","text":"’s override of the servers array is the"},{"type":"text","text":" "},{"type":"text","text":"description, the description of the "},{"code":"Server","type":"codeVoice"},{"type":"text","text":" returned by this"},{"type":"text","text":" "},{"type":"text","text":"property will be that of the root document definition."}],"type":"paragraph"}]}]}],"hierarchy":{"paths":[["doc:\/\/OpenAPIKit\/documentation\/OpenAPIKit","doc:\/\/OpenAPIKit\/documentation\/OpenAPIKit\/DereferencedDocument"]]},"references":{"doc://OpenAPIKit/documentation/OpenAPIKit":{"title":"OpenAPIKit","abstract":[],"role":"collection","identifier":"doc:\/\/OpenAPIKit\/documentation\/OpenAPIKit","url":"\/documentation\/openapikit","type":"topic","kind":"symbol"},"doc://OpenAPIKit/documentation/OpenAPIKit/DereferencedDocument/allServers":{"url":"\/documentation\/openapikit\/dereferenceddocument\/allservers","abstract":[{"type":"text","text":"All servers referenced anywhere in the whole document."}],"identifier":"doc:\/\/OpenAPIKit\/documentation\/OpenAPIKit\/DereferencedDocument\/allServers","role":"symbol","title":"allServers","kind":"symbol","type":"topic","fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"allServers","kind":"identifier"},{"text":": [","kind":"text"},{"text":"OpenAPI","kind":"typeIdentifier","preciseIdentifier":"s:10OpenAPIKit0A3APIO"},{"text":".","kind":"text"},{"text":"Server","kind":"typeIdentifier","preciseIdentifier":"s:10OpenAPIKit0A3APIO6ServerV"},{"text":"]","kind":"text"}]},"doc://OpenAPIKit/documentation/OpenAPIKit/OpenAPI/Server":{"role":"symbol","type":"topic","url":"\/documentation\/openapikit\/openapi\/server","abstract":[{"text":"OpenAPI Spec “Server Object”","type":"text"}],"kind":"symbol","title":"OpenAPI.Server","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Server","kind":"identifier"}],"identifier":"doc:\/\/OpenAPIKit\/