{"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/OpenAPIKit\/documentation\/OpenAPIKit\/DereferencedDocument\/allServers"},"sections":[],"abstract":[{"type":"text","text":"All servers referenced anywhere in the whole document."}],"kind":"symbol","schemaVersion":{"minor":3,"patch":0,"major":0},"primaryContentSections":[{"declarations":[{"tokens":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"allServers"},{"kind":"text","text":": ["},{"kind":"typeIdentifier","text":"OpenAPI","identifier":"doc:\/\/OpenAPIKit\/documentation\/OpenAPIKit\/OpenAPI","preciseIdentifier":"s:10OpenAPIKit0A3APIO"},{"kind":"text","text":"."},{"kind":"typeIdentifier","text":"Server","identifier":"doc:\/\/OpenAPIKit\/documentation\/OpenAPIKit\/OpenAPI\/Server","preciseIdentifier":"s:10OpenAPIKit0A3APIO6ServerV"},{"kind":"text","text":"] { "},{"kind":"keyword","text":"get"},{"kind":"text","text":" }"}],"platforms":["Linux"],"languages":["swift"]}],"kind":"declarations"},{"content":[{"level":2,"type":"heading","text":"Discussion","anchor":"discussion"},{"inlineContent":[{"type":"text","text":"This property contains all servers defined at any level the document"},{"type":"text","text":" "},{"type":"text","text":"and therefore may or may not contain servers not found in the"},{"type":"text","text":" "},{"type":"text","text":"root servers array."}],"type":"paragraph"},{"inlineContent":[{"text":"The ","type":"text"},{"type":"codeVoice","code":"servers"},{"text":" property on ","type":"text"},{"type":"codeVoice","code":"OpenAPI.Document"},{"text":", by contrast, contains","type":"text"},{"text":" ","type":"text"},{"text":"servers that are applicable to all paths and operations that","type":"text"},{"text":" ","type":"text"},{"text":"do not define their own ","type":"text"},{"type":"codeVoice","code":"serves"},{"text":" array to override the root array.","type":"text"}],"type":"paragraph"},{"name":"Important","type":"aside","content":[{"inlineContent":[{"