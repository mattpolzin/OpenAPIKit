{"identifier":{"url":"doc:\/\/Yams\/documentation\/Yams\/Emitter\/Options-swift.struct\/redundancyAliasingStrategy","interfaceLanguage":"swift"},"kind":"symbol","metadata":{"symbolKind":"property","modules":[{"name":"Yams"}],"role":"symbol","roleHeading":"Instance Property","fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"redundancyAliasingStrategy"},{"kind":"text","text":": "},{"preciseIdentifier":"s:4Yams26RedundancyAliasingStrategyP","kind":"typeIdentifier","text":"RedundancyAliasingStrategy"},{"kind":"text","text":"?"}],"title":"redundancyAliasingStrategy","externalID":"s:4Yams7EmitterC7OptionsV26redundancyAliasingStrategyAA010RedundancyeF0_pSgvp"},"sections":[],"hierarchy":{"paths":[["doc:\/\/Yams\/documentation\/Yams","doc:\/\/Yams\/documentation\/Yams\/Emitter","doc:\/\/Yams\/documentation\/Yams\/Emitter\/Options-swift.struct"]]},"schemaVersion":{"major":0,"patch":0,"minor":3},"abstract":[{"text":"Redundancy aliasing strategy to use when encoding. Defaults to nil","type":"text"}],"primaryContentSections":[{"declarations":[{"platforms":["Linux"],"languages":["swift"],"tokens":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"redundancyAliasingStrategy","kind":"identifier"},{"text":": ","kind":"text"},{"text":"RedundancyAliasingStrategy","kind":"typeIdentifier","identifier":"doc:\/\/Yams\/documentation\/Yams\/RedundancyAliasingStrategy","preciseIdentifier":"s:4Yams26RedundancyAliasingStrategyP"},{"text":"?","kind":"text"}]}],"kind":"declarations"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/yams\/emitter\/options-swift.struct\/redundancyaliasingstrategy"]}],"references":{"doc://Yams/documentation/Yams/RedundancyAliasingStrategy":{"identifier":"doc:\/\/Yams\/documentation\/Yams\/RedundancyAliasingStrategy","title":"RedundancyAliasingStrategy","url":"\/documentation\/yams\/redundancyaliasingstrategy","navigatorTitle":[{"kind":"identifier","text":"RedundancyAliasingStrategy"}],"kind":"symbol","abstract":[{"type":"text","text":"A class-bound protocol which implements a strategy for detecting aliasable values in a YAML document."},{"type":"text","text":" "},{"type":"text","text":"Implementations should return RedundancyAliasingOutcome.anchor(…) for the first occurrence of a value."},{"type":"text","text":" "},{"type":"text","text":"Subsequent occurrences of the same value (where same-ness is defined by the implementation) should"},{"type":"text","text":" "},{"type":"text","text":"return RedundancyAliasingOutcome.alias(…) where the contained Anchor has the same value as the previously"},{"type":"text","text":" "},{"type":"text","text":"returned RedundancyAliasingOutcome.anchor(…). Its the identity of the Anchor values returned that ultimately"},{"type":"text","text":" "},{"type":"text","text":"informs the YAML encoder when to use aliases."},{"type":"text","text":" "},{"type":"text","text":"N,B. It is essential that implementations release all references to Anchors which are created by this type"},{"type":"text","text":" "},{"type":"text","text":"when releaseAnchorReferences() is called by the Encoder. After this call the implementation will no longer be"},{"type":"text","text":" "},{"type":"text","text":"referenced by the Encoder and will itself be released."}],"role":"symbol","type":"topic","fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"RedundancyAliasingStrategy"}]},"doc://Yams/documentation/Yams/Emitter/Options-swift.struct/redundancyAliasingStrategy":{"abstract":[{"type":"text","text":"Redundancy aliasing strategy to use when encoding. Defaults to nil"}],"url":"\/documentation\/yams\/emitter\/options-swift.struct\/redundancyaliasingstrategy","identifier":"doc:\/\/Yams\/documentation\/Yams\/Emitter\/Options-swift.struct\/redundancyAliasingStrategy","kind":"symbol","type":"topic","fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"i