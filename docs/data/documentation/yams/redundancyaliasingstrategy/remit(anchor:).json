{"metadata":{"externalID":"s:4Yams26RedundancyAliasingStrategyP5remit6anchoryAA6AnchorC_tKF","required":true,"roleHeading":"Instance Method","role":"symbol","title":"remit(anchor:)","modules":[{"name":"Yams"}],"symbolKind":"method","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"remit","kind":"identifier"},{"text":"(","kind":"text"},{"text":"anchor","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Anchor","kind":"typeIdentifier","preciseIdentifier":"s:4Yams6AnchorC"},{"text":") ","kind":"text"},{"text":"throws","kind":"keyword"}]},"hierarchy":{"paths":[["doc:\/\/Yams\/documentation\/Yams","doc:\/\/Yams\/documentation\/Yams\/RedundancyAliasingStrategy"]]},"abstract":[{"text":"Implementations must remove all reference to the supplied anchor, permitting it to be deallocated.","type":"text"}],"schemaVersion":{"patch":0,"minor":3,"major":0},"identifier":{"url":"doc:\/\/Yams\/documentation\/Yams\/RedundancyAliasingStrategy\/remit(anchor:)","interfaceLanguage":"swift"},"primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["Linux"],"languages":["swift"],"tokens":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"remit","kind":"identifier"},{"text":"(","kind":"text"},{"text":"anchor","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Anchor","kind":"typeIdentifier","identifier":"doc:\/\/Yams\/documentation\/Yams\/Anchor","preciseIdentifier":"s:4Yams6AnchorC"},{"text":") ","kind":"text"},{"text":"throws","kind":"keyword"}]}]}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/yams\/redundancyaliasingstrategy\/remit(anchor:)"]}],"sections":[],"kind":"symbol","references":{"doc://Yams/documentation/Yams":{"role":"collection","type":"topic","title":"Yams","kind":"symbol","abstract":[],"identifier":"doc:\/\/Yams\/documentation\/Yams","url":"\/documentation\/yams"},"doc://Yams/documentation/Yams/RedundancyAliasingStrategy/remit(anchor:)":{"identifier":"doc:\/\/Yams\/documentation\/Yams\/RedundancyAliasingStrategy\/remit(anchor:)","abstract":[{"type":"text","text":"Implementations must remove all reference to the supplied anchor, permitting it to be deallocated."}],"url":"\/documentation\/yams\/redundancyaliasingstrategy\/remit(anchor:)","kind":"symbol","required":true,"type":"topic","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"remit","kind":"identifier"},{"text":"(","kind":"text"},{"text":"anchor","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Anchor","kind":"typeIdentifier","preciseIdentifier":"s:4Yams6AnchorC"},{"text":") ","kind":"text"},{"text":"throws","kind":"keyword"}],"role":"symbol","title":"remit(anchor:)"},"doc://Yams/documentation/Yams/Anchor":{"fragments":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"Anchor"}],"kind":"symbol","url":"\/documentation\/yams\/anchor","abstract":[{"type":"text","text":"A representation of a YAML tag see: https:\/\/yaml.org\/spec\/1.2.2\/"},{"type":"text","text":" "},{"type":"text","text":"Types interested in Encoding and Decoding Anchors should"},{"type":"text","text":" "},{"type":"text","text":"conform to YamlAnchorProviding and YamlAnchorCoding respectively."}],"role":"symbol","type":"topic","title":"Anchor","identifier":"doc:\/\/Yams\/documentation\/Yams\/Anchor","navigatorTitle":[{"kind":"identifier","text":"Anchor"}]},"doc://Yams/documentation/Yams/RedundancyAliasingStrategy":{"identifier":"doc:\/\/Yams\/documentation\/Yams\/RedundancyAliasingStrategy","title":"RedundancyAliasingStrategy","url":"\/documentation\/yams\/redundancyaliasingstrategy","navigatorTitle":[{"kind":"identifier","text":"RedundancyAliasingStrategy"}],"kind":"symbol","abstract":[{"type":"text","text":"A class-bound protocol which implements a strategy for detecting aliasable values in a YAML document."},{"type":"text","text":" "},{"type":"text","text":"Implementations should return RedundancyAliasingOutcome.anchor(…) for the first occurrence of a value."},{"type":"text","text":" "},{"type":"text","text":"Subsequent occurrences of the same value (where same-ness is defined by the implementation) should"},{"type":"text","text":" "},{"type":"text","text":"return RedundancyAliasingOutcome.alias(…) where the contained Anchor has the same value as the previously"},{"type":"text","text":" "},{"type":"text","text":"returned RedundancyAliasingOutcome.anchor(…). Its the identity of the Anchor values returned that ultimately"},{"type":"text","text":" "},{"type":"text","text":"informs the YAML encoder when to use aliases."},{"type":"text","text":" "},{"type":"text","text":"N,B. It is essential that implementations release all references to Anchors which are created by this type"},{"type":"text","text":" "},{"type":"text","text":"when releaseAnchorReferences() is called by the Encoder. After this call the implementation will no longer be"},{"type":"text","text":" "},{"type":"text","text":"referenced by the Encoder and will itself be released."}],"role":"symbol","type":"topic","fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"RedundancyAliasingStrategy"}]}}}