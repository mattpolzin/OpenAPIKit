 of the Anchor values returned that ultimately"},{"type":"text","text":" "},{"type":"text","text":"informs the YAML encoder when to use aliases."},{"type":"text","text":" "},{"type":"text","text":"N,B. It is essential that implementations release all references to Anchors which are created by this type"},{"type":"text","text":" "},{"type":"text","text":"when releaseAnchorReferences() is called by the Encoder. After this call the implementation will no longer be"},{"type":"text","text":" "},{"type":"text","text":"referenced by the Encoder and will itself be released."}],"role":"symbol","type":"topic","fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"RedundancyAliasingStrategy"}]},"doc://Yams/documentation/Yams":{"role":"collection","type":"topic","title":"Yams","kind":"symbol","abstract":[],"identifier":"doc:\/\/Yams\/documentation\/Yams","url":"\/documentation\/yams"}}}