urned RedundancyAliasingOutcome.anchor(…). Its the identity of the Anchor values returned that ultimately"},{"type":"text","text":" "},{"type":"text","text":"informs the YAML encoder when to use aliases."},{"type":"text","text":" "},{"type":"text","text":"N,B. It is essential that implementations release all references to Anchors which are created by this type"},{"type":"text","text":" "},{"type":"text","text":"when releaseAnchorReferences() is called by the Encoder. After this call the implementation will no longer be"},{"type":"text","text":" "},{"type":"text","text":"referenced by the Encoder and will itself be released."}],"role":"symbol","type":"topic","fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"RedundancyAliasingStrategy"}]},"doc://Yams/documentation/Yams/HashableAliasingStrategy/init()":{"fragments":[{"kind":"identifier","text":"init"},{"kind":"text","text":"()"}],"abstract":[{"text":"Initialize a new HashableAliasingStrategy","type":"text"}],"type":"topic","identifier":"doc:\/\/Yams\/documentation\/Yams\/HashableAliasingStrategy\/init()","url":"\/documentation\/yams\/hashablealiasingstrategy\/init()","role":"symbol","title":"init()","kind":"symbol"},"doc://Yams/documentation/Yams/HashableAliasingStrategy":{"navigatorTitle":[{"text":"HashableAliasingStrategy","kind":"identifier"}],"type":"topic","title":"HashableAliasingStrategy","identifier":"doc:\/\/Yams\/documentation\/Yams\/HashableAliasingStrategy","role":"symbol","url":"\/documentation\/yams\/hashablealiasingstrategy","abstract":[{"type":"text","text":"An implementation of RedundancyAliasingStrategy that defines alias-ability by Hashable-Equality."},{"type":"text","text":" "},{"type":"text","text":"i.e. if two values are Hashable-Equal, they will be aliased in the resultant YML document."}],"fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"HashableAliasingStrategy","kind":"identifier"}],"kind":"symbol"},"doc:/