{"variants":[{"paths":["\/documentation\/yams\/basicaliasdereferencingstrategy"],"traits":[{"interfaceLanguage":"swift"}]}],"hierarchy":{"paths":[["doc:\/\/Yams\/documentation\/Yams"]]},"sections":[],"abstract":[{"type":"text","text":"A AliasDereferencingStrategy which caches all values (even value-type values) in a Dictionary,"},{"type":"text","text":" "},{"type":"text","text":"keyed by their Anchor."},{"type":"text","text":" "},{"type":"text","text":"For reference types, this strategy achieves reference coalescing"},{"type":"text","text":" "},{"type":"text","text":"For value types, this strategy achieves short-cutting the decoding process when dereferencing aliases."},{"type":"text","text":" "},{"type":"text","text":"if the aliased structure is large, this may result in a time savings"}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/Yams\/documentation\/Yams\/BasicAliasDereferencingStrategy"},"schemaVersion":{"major":0,"minor":3,"patch":0},"metadata":{"fragments":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"BasicAliasDereferencingStrategy"}],"modules":[{"name":"Yams"}],"externalID":"s:4Yams31BasicAliasDereferencingStrategyC","navigatorTitle":[{"kind":"identifier","text":"BasicAliasDereferencingStrategy"}],"role":"symbol","symbolKind":"class","roleHeading":"Class","title":"BasicAliasDereferencingStrategy"},"kind":"symbol","relationshipsSections":[{"title":"Conforms To","identifiers":["doc:\/\/Yams\/documentation\/Yams\/AliasDereferencingStrategy"],"type":"conformsTo","kind":"relationships"}],"topicSections":[{"title":"Initializers","generated":true,"identifiers":["doc:\/\/Yams\/documentation\/Yams\/BasicAliasDereferencingStrategy\/init()"],"anchor":"Initializers"},{"title":"Subscripts","generated":true,"identifiers":["doc:\/\/Yams\/documentation\/Yams\/BasicAliasDereferencingStrategy\/subscript(_:)"],"anchor":"Subscripts"}],"primaryContentSections":[{"declarations":[{"platforms":["Linux"],"languages":["swift"],"tokens":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"BasicAliasDereferencingStrategy","kind":"identifier"}]}],"kind":"declarations"}],"references":{"doc://Yams/documentation/Yams/BasicAliasDereferencingStrategy/init()":{"kind":"symbol","role":"symbol","url":"\/documentation\/yams\/basicaliasdereferencingstrategy\/init()","fragments":[{"text":"init","kind":"identifier"},{"text":"()","kind":"text"}],"identifier":"doc:\/\/Yams\/documentation\/Yams\/BasicAliasDereferencingStrategy\/init()","abstract":[{"text":"Create a new BasicAliasDereferencingStrategy","type":"text"}],"type":"topic","title":"init()"},"doc://Yams/documentation/Yams/AliasDereferencingStrategy":{"title":"AliasDereferencingStrategy","url":"\/documentation\/yams\/aliasdereferencingstrategy","fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"AliasDereferencingStrategy"}],"role":"symbol","navigatorTitle":[{"kind":"identifier","text":"AliasDereferencingStrategy"}],"type":"topic","abstract":[{"text":"A class-bound protocol which implements a strategy for dereferencing aliases (or dealiasing) values during","type":"text"},{"text":" ","type":"text"},{"text":"YAML document decoding. YAML documents which do not contain anchors will not benefit from the use of","type":"text"},{"text":" ","type":"text"},{"text":"an AliasDereferencingStrategy in any way. The main use-case for dereferencing aliases in a YML document","type":"text"},{"text":" ","type":"text"},{"text":"is when decoding into class types. If the yaml document is large and contains many references","type":"text"},{"text":" ","type":"text"},{"text":"(perhaps it is a representation of a dense graph) then, decoding into structs will require the of large amounts","type":"text"},{"text":" ","type":"text"},{"text":"of system memory to represent highly redundant (duplicated) data structures.","type":"text"},{"text":" ","type":"text"},{"text":"However, if the same document is decoded into class types and the decoding uses","type":"text"},{"text":" ","type":"text"},{"text":"an ","type":"text"},{"type":"codeVoice","code":"AliasDereferencingStrategy"},{"text":" such as ","type":"text"},{"type":"codeVoice","code":"BasicAliasDereferencingStrategy"},{"text":" then the emitted value will have its","type":"text"},{"text":" ","type":"text"},{"text":"class references coalesced. No duplicate objects will be initialized (unless identical objects have multiple","type":"text"},{"text":" ","type":"text"},{"text":"distinct anchors in the YAML document). In some scenarios this may significantly reduce the memory footprint of","type":"text"},{"text":" ","type":"text"},{"text":"the decoded type.","type":"text"}],"kind":"symbol","identifier":"doc:\/\/Yams\/documentation\/Yams\/AliasDereferencingStrategy"},"doc://Yams/documentation/Yams/BasicAliasDereferencingStrategy":{"kind":"symbol","role":"symbol","url":"\/documentation\/yams\/basicaliasdereferencingstrategy","fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"BasicAliasDereferencingStrategy","kind":"identifier"}],"identifier":"doc:\/\/Yams\/documentation\/Yams\/BasicAliasDereferencingStrategy","abstract":[{"text":"A AliasDereferencingStrategy which caches all values (even value-type values) in a Dictionary,","type":"text"},{"text":" ","type":"text"},{"text":"keyed by their Anchor.","type":"text"},{"text":" ","type":"text"},{"text":"For reference types, this strategy achieves reference coalescing","type":"text"},{"text":" ","type":"text"},{"text":"For value types, this strategy achieves short-cutting the decoding process when dereferencing aliases.","type":"text"},{"text":" ","type":"text"},{"text":"if the aliased structure is large, this may result in a time savings","type":"text"}],"navigatorTitle":[{"text":"BasicAliasDereferencingStrategy","kind":"identifier"}],"title":"BasicAliasDereferencingStrategy","type":"topic"},"doc://Yams/documentation/Yams/BasicAliasDereferencingStrategy/subscript(_:)":{"url":"\/documentation\/yams\/basicaliasdereferencingstrategy\/subscript(_:)","kind":"symbol","title":"subscript(_:)","type":"topic","role":"symbol","fragments":[{"kind":"keyword","text":"subscript"},{"kind":"text","text":"("},{"kind":"typeIdentifier","preciseIdentifier":"s:4Yams6AnchorC","text":"Anchor"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","preciseIdentifier":"s:4Yams26AliasDereferencingStrategyP5Valuea","text":"Value"},{"kind":"text","text":"?"}],"identifier":"doc:\/\/Yams\/documentation\/Yams\/BasicAliasDereferencingStrategy\/subscript(_:)","abstract":[{"text":"get and set cached references, keyed bo an Anchor","type":"text"}]},"doc://Yams/documentation/Yams":{"role":"collection","type":"topic","title":"Yams","kind":"symbol","abstract":[],"identifier":"doc:\/\/Yams\/documentation\/Yams","url":"\/documentation\/yams"}}}