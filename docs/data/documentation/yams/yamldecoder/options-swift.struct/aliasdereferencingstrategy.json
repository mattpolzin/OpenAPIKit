ecoder","kind":"identifier"}],"type":"topic","kind":"symbol","title":"YAMLDecoder","abstract":[{"code":"Codable","type":"codeVoice"},{"type":"text","text":"-style "},{"code":"Decoder","type":"codeVoice"},{"type":"text","text":" that can be used to decode a "},{"code":"Decodable","type":"codeVoice"},{"type":"text","text":" type from a given "},{"code":"String","type":"codeVoice"},{"type":"text","text":" and optional"},{"type":"text","text":" "},{"type":"text","text":"user info mapping. Similar to "},{"code":"Foundation.JSONDecoder","type":"codeVoice"},{"type":"text","text":"."}],"url":"\/documentation\/yams\/yamldecoder"},"doc://Yams/documentation/Yams/YAMLDecoder/Options-swift.struct":{"type":"topic","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Options"}],"abstract":[{"type":"text","text":"Options to use when decoding from YAML."}],"identifier":"doc:\/\/Yams\/documentation\/Yams\/YAMLDecoder\/Options-swift.struct","navigatorTitle":[{"kind":"identifier","text":"Options"}],"kind":"symbol","url":"\/documentation\/yams\/yamldecoder\/options-swift.struct","role":"symbol","title":"YAMLDecoder.Options"},"doc://Yams/documentation/Yams/YAMLDecoder/Options-swift.struct/aliasDereferencingStrategy":{"title":"aliasDereferencingStrategy","abstract":[{"text":"Alias dereferencing strategy to use when decoding. Defaults to nil","type":"text"}],"url":"\/documentation\/yams\/yamldecoder\/options-swift.struct\/aliasdereferencingstrategy","kind":"symbol","fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"aliasDereferencingStrategy"},{"kind":"text","text":": "},{"preciseIdentifier":"s:4Yams26AliasDereferencingStrategyP","kind":"typeIdentifier","text":"AliasDereferencingStrategy"},{"kind":"text","text":"?"}],"type":"topic","role":"symbol","identifier":"doc:\/\/Yams\/documentation\/Yams\/YAMLDecoder\/Options-swift.struct\/aliasDereferencingStrategy"},"doc://Yams/documentation/Yams/AliasDereferencingStrategy":{"title":"AliasDereferencingStrategy","url":"\/documentation\/yams\/aliasdereferencingstrategy","fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"AliasDereferencingStrategy"}],"role":"symbol","navigatorTitle":[{"kind":"identifier","text":"AliasDereferencingStrategy"}],"type":"topic","abstract":[{"text":"A class-bound protocol which implements a strategy for dereferencing aliases (or dealiasing) values during","type":"text"},{"text":" ","type":"text"},{"text":"YAML document decoding. YAML documents which do not contain anchors will not benefit from the use of","type":"text"},{"text":" ","type":"text"},{"text":"an AliasDereferencingStrategy in any way. The main use-case for dereferencing aliases in a YML document","type":"text"},{"text":" ","type":"text"},{"text":"is when decoding into class types. If the yaml document is large and contains many references","type":"text"},{"text":" ","type":"text"},{"text":"(perhaps it is a representation of a dense graph) then, decoding into structs will require the of large amounts","type":"text"},{"text":" ","type":"text"},{"text":"of system memory to represent highly redundant (duplicated) data structures.","type":"text"},{"text":" ","type":"text"},{"text":"However, if the same document is decoded into class types and the decoding uses","type":"text"},{"text":" ","type":"text"},{"text":"an ","type":"text"},{"type":"codeVoice","code":"AliasDereferencingStrategy"},{"text":" such as ","type":"text"},{"type":"codeVoice","code":"BasicAliasDereferencingStrategy"},{"text":" then the emitted value will have its","type":"text"},{"text":" ","type":"text"},{"text":"class references coalesced. No duplicate objects will be initialized (unless identical objects have multiple","type":"text"},{"text":" ","type":"text"},{"text":"distinct anchors in the YAML document). In some scenarios this may significantly reduce the memory footprint of","type":"text"},{"text":" ","type":"text"},{"text":"the decoded type.","type":"text"}],"kind":"symbol","identifier":"doc:\/\/Yams\/documentation\/Yams\/AliasDereferencingStrategy"},"doc://Yams/documentation/Yams":{"role":"collection","type":"topic","title":"Yams","kind":"symbol","abstract":[],"identifier":"doc:\/\/Yams\/documentation\/Yams","url":"\/documentation\/yams"}}}