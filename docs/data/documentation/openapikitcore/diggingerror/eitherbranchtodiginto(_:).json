{"sections":[],"abstract":[{"text":"Returns one of the branches of the ","type":"text"},{"code":"EitherDecodeNoTypesMatchedError","type":"codeVoice"},{"text":" ","type":"text"},{"text":"or ","type":"text"},{"code":"nil","type":"codeVoice"},{"text":", depending on whether it is heuristically beneficial to dig into either","type":"text"},{"text":" ","type":"text"},{"text":"branch in search of a more granular error.","type":"text"}],"primaryContentSections":[{"kind":"declarations","declarations":[{"languages":["swift"],"tokens":[{"text":"static","kind":"keyword"},{"text":" ","kind":"text"},{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"eitherBranchToDigInto","kind":"identifier"},{"text":"(","kind":"text"},{"text":"_","kind":"externalParam"},{"text":" ","kind":"text"},{"text":"eitherError","kind":"internalParam"},{"text":": ","kind":"text"},{"text":"EitherDecodeNoTypesMatchedError","preciseIdentifier":"s:14OpenAPIKitCore31EitherDecodeNoTypesMatchedErrorV","identifier":"doc:\/\/OpenAPIKitCore\/documentation\/OpenAPIKitCore\/EitherDecodeNoTypesMatchedError","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"text":"DecodingError","preciseIdentifier":"s:s13DecodingErrorO","kind":"typeIdentifier"},{"text":"?","kind":"text"}],"platforms":["Linux"]}]},{"kind":"content","content":[{"text":"Discussion","level":2,"type":"heading","anchor":"discussion"},{"type":"paragraph","inlineContent":[{"type":"text","text":"If an "},{"code":"Either","type":"codeVoice"},{"type":"text","text":" fails to decode and the most useful error for the user is just"},{"type":"text","text":" "},{"type":"text","text":"that neither option of the "},{"code":"Either","type":"codeVoice"},{"type":"text","text":" was found, then this function returns "},{"code":"nil","type":"codeVoice"},{"type":"text","text":" "},{"type":"text","text":"which indicates neither branch should be dug into."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"On the other hand, one of the two branches of the "},{"type":"codeVoice","code":"Either"},{"type":"text","text":" might have failed to decode"},{"type":"text","text":" "},{"type":"text","text":"trivially (i.e. the user does not need to know that both branches failed because one"},{"type":"text","text":" "},{"type":"text","text":"of those branches is very unlikely to have been the intended one). If that happens, it is"},{"type":"text","text":" "},{"type":"text","text":"more useful to dig into the less trivial branch and display a more granular error to the user"},{"type":"text","text":" "},{"type":"text","text":"from deeper in that brach. When this occurs, this function retruns the underlying error on"},{"type":"text","text":" "},{"type":"text","text":"that branch."}]}]}],"hierarchy":{"paths":[["doc:\/\/OpenAPIKitCore\/documentation\/OpenAPIKitCore","doc:\/\/OpenAPIKitCore\/documentation\/OpenAPIKitCore\/DiggingError"]]},"identifier":{"url":"doc:\/\/OpenAPIKitCore\/documentation\/OpenAPIKitCore\/DiggingError\/eitherBranchToDigInto(_:)","interfaceLanguage":"swift"},"kind":"symbol","variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/openapikitcore\/diggingerror\/eitherbranchtodiginto(_:)"]}],"schemaVersion":{"patch":0,"major":0,"minor":3},"metadata":{"externalID":"s:14OpenAPIKitCore12DiggingErrorPAAE21eitherBranchToDigIntoys08DecodingE0OSgAA026EitherDecodeNoTypesMatchedE0VFZ","fragments":[{"text":"static","kind":"keyword"},{"text":" ","kind":"text"},{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"eitherBranchToDigInto","kind":"identifier"},{"text":"(","kind":"text"},{"text":"EitherDecodeNoTypesMatchedError","kind":"typeIdentifier","preciseIdentifier":"s:14OpenAPIKitCore31EitherDecodeNoTypesMatchedErrorV"},{"text":") -> ","kind":"text"},{"text":"DecodingError","kind":"typeIdentifier","preciseIdentifier":"s:s13DecodingErrorO"},{"text":"?","kind":"text"}],"role":"symbol","symbolKind":"method","extendedModule":"OpenAPIKitCore","roleHeading":"Type Method","m