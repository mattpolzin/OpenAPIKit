{"sections":[],"abstract":[{"type":"text","text":"Returns one of the branches of the "},{"code":"EitherDecodeNoTypesMatchedError","type":"codeVoice"},{"type":"text","text":" "},{"type":"text","text":"or "},{"code":"nil","type":"codeVoice"},{"type":"text","text":", depending on whether it is heuristically beneficial to dig into either"},{"type":"text","text":" "},{"type":"text","text":"branch in search of a more granular error."}],"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"kind":"keyword","text":"static"},{"kind":"text","text":" "},{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"eitherBranchToDigInto"},{"kind":"text","text":"("},{"kind":"externalParam","text":"_"},{"kind":"text","text":" "},{"kind":"internalParam","text":"eitherError"},{"kind":"text","text":": "},{"kind":"typeIdentifier","identifier":"doc:\/\/OpenAPIKitCore\/documentation\/OpenAPIKitCore\/EitherDecodeNoTypesMatchedError","text":"EitherDecodeNoTypesMatchedError","preciseIdentifier":"s:14OpenAPIKitCore31EitherDecodeNoTypesMatchedErrorV"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","text":"DecodingError","preciseIdentifier":"s:s13DecodingErrorO"},{"kind":"text","text":"?"}],"platforms":["Linux"],"languages":["swift"]}]},{"kind":"content","content":[{"text":"Discussion","anchor":"discussion","level":2,"type":"heading"},{"type":"paragraph","inlineContent":[{"type":"text","text":"If an "},{"type":"codeVoice","code":"Either"},{"type":"text","text":" fails to decode and the most useful error for the user is just"},{"type":"text","text":" "},{"type":"text","text":"that neither option of the "},{"type":"codeVoice","code":"Either"},{"type":"text","text":" was found, then this function returns "},{"type":"codeVoice","code":"nil"},{"type":"text","text":" "},{"type":"text","text":"which indicates neither branch should be dug into."}]},{"type":"paragraph","inlineContent":[{"text":"On the other hand, one of the two branches of the ","type":"text"},{"code":"Either","type":"codeVoice"},{"text":" might have failed to decode","type":"text"},{"text":" ","type":"text"},{"text":"trivially (i.e. the user does not need to know that both branches failed because one","type":"text"},{"text":" ","type":"text"},{"text":"of those branches is very unlikely to have been the intended one). If that happens, it is","type":"text"},{"text":" ","type":"text"},{"text":"more useful to dig into the less trivial branch and display a more granular error to the user","type":"text"},{"text":" ","type":"text"},{"text":"from deeper in that brach. When this occurs, this function retruns the underlying error on","type":"text"},{"text":" ","type":"text"},{"text":"that branch.","type":"text"}]}]}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/openapikitcore\/error\/decoding\/request\/eitherbranchtodiginto(_:)"]}],"schemaVersion":{"major":0,"minor":3,"patch":0},"kind":"symbol","metadata":{"externalID":"s:14OpenAPIKitCore12DiggingErrorPAAE21eitherBranchToDigIntoys08DecodingE0OSgAA026EitherDecodeNoTypesMatchedE0VFZ::SYNTHESIZED::s:14OpenAPIKitCore5ErrorV8DecodingO7RequestV","symbolKind":"method","title":"eitherBranchToDigInto(_:)","role":"symbol","modules":[{"name":"OpenAPIKitCore"}],"extendedModule":"OpenAPIKitCore","fragments":[{"kind":"keyword","text":"static"},{"kind":"text","text":" "},{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"eitherBranchToDigInto"},{"kind":"text","text":"("},{"preciseIdentifier":"s:14OpenAPIKitCore31EitherDecodeNoTypesMatchedErrorV","kind":"typeIdentifier","text":"EitherDecodeNoTypesMatchedError"},{"kind":"text","text":") -> "},{"preciseIdentifier":"s:s13DecodingErrorO","kind":"typeIdentifier","text":"DecodingError"},{"kind":"text","text":"?"}],"roleHeading":"Type Method"},"hierarchy":{"paths":[["doc:\/\/OpenAPIKitCore\/documentation\/OpenAPIKitCore","doc:\/\/OpenAPIKitCore\/documentation\/OpenAPIKitCore\/Error","doc:\/\/Ope