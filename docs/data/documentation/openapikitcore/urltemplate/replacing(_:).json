{"sections":[],"abstract":[{"type":"text","text":"For all variables in this template that have keys in the given dictionary,"},{"type":"text","text":" "},{"type":"text","text":"replace the variable with the value under the given key."}],"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"replacing"},{"kind":"text","text":"("},{"kind":"externalParam","text":"_"},{"kind":"text","text":" "},{"kind":"internalParam","text":"variableDictionary"},{"kind":"text","text":": ["},{"kind":"typeIdentifier","text":"String","preciseIdentifier":"s:SS"},{"kind":"text","text":" : "},{"kind":"typeIdentifier","text":"String","preciseIdentifier":"s:SS"},{"kind":"text","text":"]) -> "},{"identifier":"doc:\/\/OpenAPIKitCore\/documentation\/OpenAPIKitCore\/URLTemplate","kind":"typeIdentifier","text":"URLTemplate","preciseIdentifier":"s:14OpenAPIKitCore11URLTemplateV"}],"languages":["swift"],"platforms":["Linux"]}]},{"content":[{"text":"Discussion","level":2,"type":"heading","anchor":"discussion"},{"inlineContent":[{"text":"This results in a new ","type":"text"},{"type":"codeVoice","code":"URLTemplate"},{"text":" with a constant value in place of all","type":"text"},{"text":" ","type":"text"},{"text":"variables that were replaced. The ","type":"text"},{"type":"codeVoice","code":"URLTemplate"},{"text":" gets reformed, so any","type":"text"},{"text":" ","type":"text"},{"text":"constants formed by such a replacement that neighbor other constants","type":"text"},{"text":" ","type":"text"},{"text":"become one constant (there will never be two constants next to each other,","type":"text"},{"text":" ","type":"text"},{"text":"even after variable replacement occurs).","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"If you have replaced all variables in the template, you can attempt to create a"},{"type":"text","text":" "},{"type":"text","text":"well-formed Foundation "},{"type":"codeVoice","code":"URL"},{"type":"text","text":" by accessing the "},{"type":"codeVoice","code":"url"},{"type":"text","text":" property of the resulting"},{"type":"text","text":" "},{"type":"codeVoice","code":"URLTemplate"},{"type":"text","text":"."}],"type":"paragraph"},{"inlineContent":[{"type":"strong","inlineContent":[{"text":"Example","type":"text"}]}],"type":"paragraph"},{"syntax":null,"type":"codeListing","code":["\"{scheme}:\/\/{website}.com\/{path}\"","[","    .variable(name: \"scheme\"),","    .constant(\":\/\/\"),","    .variable(name: \"website\"),","    .constant(\".com\/\")","    .variable(name: \"path\")","]","","-> replacing([\"scheme\": \"https\", \"path\": \"welcome\"])","","\"https:\/\/{website}.com\/welcome\"","[","    .constant(\"https:\/\/\"),","    .variable(name: \"website\"),","    .constant(\".com\/welcome\")","]"]},{"inlineContent":[{"text":"If you want to create a valid ","type":"text"},{"code":"URL","type":"codeVoice"},{"text":" from the template, all variables must be","type":"text"},{"text":" ","type":"text"},{"text":"replaced. Picking up with the above example, we could replace the last variable","type":"text"},{"text":" ","type":"text"},{"text":"and then request the ","type":"text"},{"code":"URLTemplate","type":"codeVoice"},{"text":" ","type":"text"},{"code":"url","type":"codeVoice"},{"text":" property.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"inlineContent":[{"text":"Example","type":"text"}],"type":"strong"}],"type":"paragraph"},{"syntax":null,"type":"codeListing","code":["    -> replacing([\"website\": \"mysite\"])","","    \"https:\/\/mysite.com\/welcome\"","    [","        .constant(\"https:\/\/mysite.com\/welcome\")","    ]"]}],"kind":"content"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/openapikitcore\/urltemplate\/replacing(_:)"]}],"schemaVersion":{"major":0,"minor":3,"patch":0},"kind":"symbol","metadata":{"externalID":"s:14OpenAPIKitCore11URLTemplateV9r